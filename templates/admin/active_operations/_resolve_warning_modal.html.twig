<div class="modal fade active-ops-modal" id="resolveWarningModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-info glass-card">
            <div class="modal-header">
                <h2 class="modal-title" id="resolveWarningTitle">Confirm Resolution</h2>
                <button type="button" class="btn-close btn-close-white" data-modal-dismiss aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="active-ops-modal-warning">WARNING: Marking this as 'Resolved' or 'Cancelled' will finish the operation and immediately release the engineer back to the available roster.</p>
