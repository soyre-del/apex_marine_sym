{% extends 'base.html.twig' %}

{% block title %}Command Center | Apex Marine{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}

{% block head %}
<style>
    /* ── ADM: Design-system extensions (prefix: adm-) ────────────────────── */
    :root {
        --adm-navy:    #0e2b49;
        --adm-deep:    #081c2d;
        --adm-panel:   #122d47;
        --adm-border:  #23415d;
        --adm-blue:    #0ba5df;
        --adm-text:    #f0f5ff;
        --adm-muted:   #a3b6c8;
        --adm-amber:   #f59e0b;
        --adm-green:   #10b981;
        --adm-cyan:    #06b6d4;
        --adm-red:     #ef4444;
        --adm-radius:  12px;
        --adm-shadow:  0 4px 24px rgba(0,0,0,.35);
    }

    /* ── Welcome banner ──────────────────────────────────────────────────── */
    .adm-welcome {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 2rem 2.5rem;
        background: linear-gradient(135deg, #122d47 0%, #0e2b49 60%, #081c2d 100%);
        border: 1px solid var(--adm-border);
        border-radius: var(--adm-radius);
        margin-bottom: 1.75rem;
        position: relative;
        overflow: hidden;
    }
    .adm-welcome::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 60% 80% at 90% 50%, rgba(11,165,223,.12) 0%, transparent 70%);
        pointer-events: none;
    }
    .adm-welcome-eyebrow {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .15em;
        text-transform: uppercase;
        color: var(--adm-blue);
        margin: 0 0 .35rem;
    }
    .adm-welcome-title {
        font-size: 1.65rem;
        font-weight: 700;
        color: var(--adm-text);
        margin: 0 0 .25rem;
        line-height: 1.2;
    }
    .adm-welcome-title span {
        color: var(--adm-blue);
    }
    .adm-welcome-sub {
        font-size: .85rem;
        color: var(--adm-muted);
        margin: 0;
    }
    .adm-clock-block {
        text-align: right;
        flex-shrink: 0;
    }
    .adm-clock {
        font-size: 2rem;
        font-weight: 700;
        color: var(--adm-text);
        font-variant-numeric: tabular-nums;
        line-height: 1;
    }
    .adm-date {
        font-size: .8rem;
        color: var(--adm-muted);
        margin-top: .3rem;
    }

    /* ── Stat cards ─────────────────────────────────────────────────────── */
    .adm-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.1rem;
        margin-bottom: 2rem;
    }
    .adm-stat {
        background: var(--adm-panel);
        border: 1px solid var(--adm-border);
        border-radius: var(--adm-radius);
        padding: 1.4rem 1.5rem;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        position: relative;
        overflow: hidden;
        transition: transform .18s, box-shadow .18s;
    }
    .adm-stat:hover {
        transform: translateY(-2px);
        box-shadow: var(--adm-shadow);
    }
    .adm-stat::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        border-radius: var(--adm-radius) var(--adm-radius) 0 0;
        background: var(--adm-stat-color, var(--adm-blue));
    }
    .adm-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: rgba(255,255,255,.06);
        color: var(--adm-stat-color, var(--adm-blue));
    }
    .adm-stat-icon svg { width: 22px; height: 22px; }
    .adm-stat-body { flex: 1; min-width: 0; }
    .adm-stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--adm-text);
        line-height: 1;
        margin-bottom: .2rem;
    }
    .adm-stat-label {
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--adm-muted);
    }
    .adm-stat-link {
        font-size: .75rem;
        color: var(--adm-stat-color, var(--adm-blue));
        text-decoration: none;
        display: inline-block;
        margin-top: .45rem;
        opacity: .85;
        transition: opacity .15s;
    }
    .adm-stat-link:hover { opacity: 1; text-decoration: underline; }

    /* colour tokens per card */
    .adm-stat--amber { --adm-stat-color: var(--adm-amber); }
    .adm-stat--blue  { --adm-stat-color: var(--adm-blue);  }
    .adm-stat--green { --adm-stat-color: var(--adm-green); }
    .adm-stat--cyan  { --adm-stat-color: var(--adm-cyan);  }

    /* ── Engineer roster section ─────────────────────────────────────────── */
    .adm-roster-wrap {
        background: var(--adm-panel);
        border: 1px solid var(--adm-border);
        border-radius: var(--adm-radius);
        overflow: hidden;
        margin-bottom: 2rem;
    }
    .adm-roster-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--adm-border);
    }
    .adm-roster-title {
        display: flex;
        align-items: center;
        gap: .6rem;
        font-size: 1rem;
        font-weight: 700;
        color: var(--adm-text);
        margin: 0;
    }
    .adm-roster-title svg {
        color: var(--adm-blue);
        flex-shrink: 0;
    }
    .adm-table-scroll { overflow-x: auto; }
    .adm-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .875rem;
    }
    .adm-table thead tr {
        background: #081c2d !important;
        border-bottom: 1px solid var(--adm-border);
    }
    .adm-table th {
        padding: .9rem 1.25rem;
        text-align: left;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--adm-muted) !important;
        background: #081c2d !important;
        white-space: nowrap;
    }
    .adm-table td {
        padding: .95rem 1.25rem;
        color: var(--adm-text) !important;
        background: #0e2b49 !important;
        vertical-align: middle;
        border-bottom: 1px solid rgba(35,65,93,.5);
    }
    .adm-table tbody tr:last-child td { border-bottom: none; }
    .adm-table tbody tr:hover td { background: #173b5c !important; }
    .adm-table tbody tr.is-suspended td { opacity: .55; }

    .adm-name { font-weight: 600; color: var(--adm-text); }
    .adm-email { color: var(--adm-muted); font-size: .82rem; }
    .adm-specialty {
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .04em;
        color: var(--adm-blue);
    }

    /* Status badges */
    .adm-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .28rem .7rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }
    .adm-badge::before {
        content: '';
        width: 6px; height: 6px;
        border-radius: 50%;
        background: currentColor;
        flex-shrink: 0;
    }
    .adm-badge--success { background: rgba(16,185,129,.15); color: #34d399; }
    .adm-badge--neutral { background: rgba(11,165,223,.15);  color: #38bdf8; }
    .adm-badge--warning { background: rgba(245,158,11,.15);  color: #fbbf24; }
    .adm-badge--danger  { background: rgba(239,68,68,.15);   color: #f87171; }

    /* Row action buttons */
    .adm-row-actions { display: flex; gap: .5rem; align-items: center; }
    .adm-btn {
        padding: .38rem .9rem;
        font-size: .78rem;
        font-weight: 600;
        border-radius: 7px;
        border: none;
        cursor: pointer;
        transition: filter .15s, transform .1s;
        line-height: 1;
        white-space: nowrap;
    }
    .adm-btn:hover { filter: brightness(1.15); transform: translateY(-1px); }
    .adm-btn--edit    { background: rgba(11,165,223,.18); color: #38bdf8; }
    .adm-btn--danger  { background: rgba(239,68,68,.15);  color: #f87171; }
    .adm-btn--restore { background: rgba(16,185,129,.15); color: #34d399; }
    .adm-btn--primary { background: var(--adm-blue); color: #fff; }

    .adm-empty-row {
        text-align: center;
        color: var(--adm-muted);
        padding: 3rem 1rem;
        font-size: .9rem;
    }

    /* ── Alert modernisation ─────────────────────────────────────────────── */
    .adm-alert {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: .9rem 1.25rem;
        border-radius: 9px;
        border-left: 4px solid;
        margin-bottom: 1.25rem;
        font-size: .875rem;
    }
    .adm-alert--success { background: rgba(16,185,129,.1); border-color: #10b981; color: #d1fae5; }
    .adm-alert--info    { background: rgba(11,165,223,.1); border-color: #0ba5df; color: #bae6fd; }
    .adm-alert--warning { background: rgba(245,158,11,.1); border-color: #f59e0b; color: #fef3c7; }
    .adm-alert--danger  { background: rgba(239,68,68,.1);  border-color: #ef4444; color: #fee2e2; }
    .adm-alert-close {
        background: none; border: none; cursor: pointer;
        color: inherit; opacity: .6; font-size: 1.1rem; line-height: 1;
        flex-shrink: 0; padding: 0;
    }
    .adm-alert-close:hover { opacity: 1; }

    /* ── Nav modernisation ───────────────────────────────────────────────── */
    .admin-nav {
        background: rgba(8,28,45,.97) !important;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--adm-border) !important;
        box-shadow: 0 1px 20px rgba(0,0,0,.4) !important;
    }
    .admin-nav-link {
        font-size: .78rem !important;
        font-weight: 600 !important;
        letter-spacing: .04em !important;
        border-radius: 7px !important;
        transition: background .15s, color .15s !important;
    }
    .admin-system-pill span {
        background: var(--adm-green) !important;
        box-shadow: 0 0 6px var(--adm-green) !important;
        animation: pulse-dot 2s infinite;
    }
    @keyframes pulse-dot {
        0%, 100% { opacity: 1; }
        50% { opacity: .4; }
    }

    /* ── Inline form reset ───────────────────────────────────────────────── */
    .adm-inline-form { margin: 0; }

    /* ── Modal styling & guaranteed visibility ───────────────────────────── */
    .admin-modal {
        position: fixed;
        z-index: 9999;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(4, 15, 26, .84);
        backdrop-filter: blur(8px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .2s ease, visibility .2s ease;
    }
    .admin-modal.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }
    .admin-modal-dialog {
        width: min(100%, 540px);
        max-height: min(92vh, 880px);
        overflow-y: auto;
        border: 1px solid var(--adm-border);
        border-radius: var(--adm-radius);
        background: var(--adm-panel);
        box-shadow: 0 24px 80px rgba(0, 0, 0, .65);
        transform: translateY(12px);
        transition: transform .2s ease;
    }
    .admin-modal.is-open .admin-modal-dialog {
        transform: translateY(0);
    }
    .admin-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--adm-border);
    }
    .admin-modal-header h2 {
        margin: 0;
        color: var(--adm-blue);
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: .02em;
    }
    .admin-modal-close {
        background: transparent;
        border: none;
        color: var(--adm-muted);
        font-size: 1.6rem;
        line-height: 1;
        cursor: pointer;
        padding: 4px;
        transition: color .15s;
    }
    .admin-modal-close:hover {
        color: #fff;
    }
    .admin-modal-body {
        padding: 1.5rem;
    }
    .admin-form {
        display: grid;
        gap: 1.1rem;
    }
    .admin-form label {
        display: grid;
        gap: .45rem;
        color: var(--adm-muted);
        font-size: .82rem;
        font-weight: 600;
        letter-spacing: .02em;
        text-transform: uppercase;
    }
    .admin-form input,
    .admin-form select {
        width: 100%;
        min-height: 44px;
        padding: .65rem .85rem;
        background: rgba(255, 255, 255, .05);
        border: 1px solid var(--adm-border);
        border-radius: 8px;
        color: var(--adm-text);
        font-size: .92rem;
        font-family: inherit;
        outline: none;
        transition: border-color .18s, box-shadow .18s;
    }
    .admin-form input:focus,
    .admin-form select:focus {
        border-color: var(--adm-blue);
        box-shadow: 0 0 0 3px rgba(11, 165, 223, .18);
    }
    .admin-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-family: inherit;
    }
    .admin-button-primary {
        min-height: 44px;
        background: var(--adm-blue);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: .92rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .18s, transform .15s;
    }
    .admin-button-primary:hover {
        background: #078ec2;
        transform: translateY(-1px);
    }
    .admin-button-danger {
        min-height: 40px;
        background: var(--adm-red);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: .88rem;
        font-weight: 700;
        cursor: pointer;
        padding: .5rem 1.2rem;
    }
    .admin-button-danger:hover {
        background: #dc2626;
    }
    .admin-button-cancel {
        min-height: 40px;
        background: transparent;
        color: var(--adm-muted);
        border: 1px solid var(--adm-border);
        border-radius: 8px;
        font-size: .88rem;
        font-weight: 600;
        cursor: pointer;
        padding: .5rem 1.2rem;
    }
    .admin-button-cancel:hover {
        background: rgba(255, 255, 255, .05);
        color: #fff;
    }
    .admin-modal-confirm {
        padding: 2rem;
        text-align: center;
    }
    .admin-confirm-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: rgba(239, 68, 68, .12);
        border: 1px solid rgba(239, 68, 68, .3);
        color: var(--adm-red);
        font-size: 1.7rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
    }
    .admin-confirm-actions {
        display: flex;
        justify-content: center;
        gap: .75rem;
        margin-top: 1.5rem;
    }

    /* ── Responsive tweaks ───────────────────────────────────────────────── */
    @media (max-width: 640px) {
        .adm-welcome { padding: 1.5rem; }
        .adm-welcome-title { font-size: 1.25rem; }
        .adm-clock { font-size: 1.4rem; }
        .adm-stats { grid-template-columns: 1fr 1fr; }
    }

    /* ── Admin Modal Overlay (per antigravity reference) ─────────────────── */
    .admin-modal {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        padding: 1rem;
        opacity: 0;
        transition: opacity 0.2s ease;
    }
    .admin-modal.is-open {
        display: flex;
        opacity: 1;
    }
    .admin-modal-dialog {
        background: var(--adm-panel);
        border: 1px solid var(--adm-border);
        border-radius: var(--adm-radius);
        width: 100%;
        max-width: 480px;
        max-height: 90vh;
        overflow-y: auto;
        transform: scale(0.95);
        transition: transform 0.2s ease;
        box-shadow: var(--adm-shadow);
    }
    .admin-modal.is-open .admin-modal-dialog {
        transform: scale(1);
    }
    .admin-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--adm-border);
    }
    .admin-modal-header h2 {
        margin: 0;
        font-size: 1.1rem;
        color: var(--adm-text);
    }
    .admin-modal-close {
        background: none;
        border: none;
        color: var(--adm-muted);
        font-size: 1.5rem;
        line-height: 1;
        cursor: pointer;
        padding: 0.25rem;
    }
    .admin-modal-close:hover {
        color: var(--adm-text);
    }
    .admin-modal-body {
        padding: 1.25rem;
    }
    .admin-confirm-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--adm-red);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.25rem;
        margin: 0 auto 1rem;
    }
    .admin-confirm-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        margin-top: 1.5rem;
    }
    .admin-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.6rem 1.25rem;
        border-radius: 7px;
        border: none;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: filter 0.15s;
        line-height: 1;
    }
    .admin-button-primary {
        background: var(--adm-blue);
        color: #fff;
    }
    .admin-button-danger {
        background: var(--adm-red);
        color: #fff;
    }
    .admin-button-cancel {
        background: rgba(255,255,255,0.1);
        color: var(--adm-text);
    }
    .admin-button:hover {
        filter: brightness(1.15);
    }
    .admin-form label {
        display: block;
        margin: 0 0 0.5rem;
        font-size: 0.8rem;
        color: var(--adm-muted);
    }
    .admin-form input,
    .admin-form select {
        width: 100%;
        padding: 0.6rem 0.75rem;
        border-radius: 6px;
        border: 1px solid var(--adm-border);
        background: rgba(0,0,0,0.3);
        color: var(--adm-text);
        font-size: 0.875rem;
        margin-bottom: 1rem;
        box-sizing: border-box;
    }
    .admin-form input::placeholder {
        color: var(--adm-muted);
    }
    .adm-password-wrap {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
        margin-bottom: 1rem;
    }
    .admin-form .adm-password-wrap input {
        margin-bottom: 0 !important;
        padding-right: 5.2rem !important;
    }
    .adm-password-toggle {
        position: absolute;
        top: 50%;
        right: .55rem;
        transform: translateY(-50%);
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .3rem .58rem;
        border: 1px solid rgba(11, 165, 223, .32);
        border-radius: 6px;
        background: rgba(11, 165, 223, .12);
        color: #70d7fa;
        font-family: inherit;
        font-size: .74rem;
        font-weight: 600;
        letter-spacing: .02em;
        text-transform: none;
        cursor: pointer;
        z-index: 2;
        transition: background-color .15s ease, border-color .15s ease, color .15s ease;
    }
    .adm-password-toggle:hover {
        background: rgba(11, 165, 223, .24);
        border-color: rgba(11, 165, 223, .6);
        color: #ffffff;
    }
</style>
{% endblock %}

{% block body %}
    {% set adminCsrfToken = csrf_token('admin_engineers') %}
<main class="admin-page" data-failed-action="{{ failed_action }}">

    {# ── Sticky top nav ───────────────────────────────────────────────────── #}
    <nav class="admin-nav" aria-label="Admin navigation">
        <div class="admin-nav-inner">
            <div class="admin-brand">
                <span class="admin-system-pill"><span></span>CMD_CTR</span>
                <strong>Apex Marine</strong>
            </div>
            <div class="admin-nav-actions">
                <span class="admin-identity">ID: <strong>{{ admin_name }}</strong></span>
                <a href="{{ path('admin_active_operations') }}"  class="admin-nav-link admin-nav-success">Active Ops</a>
                <a href="{{ path('admin_pending_dispatch') }}"   class="admin-nav-link admin-nav-info">Pending Dispatches</a>
                <a href="{{ path('admin_manage_clients') }}"     class="admin-nav-link admin-nav-info">Clients</a>
                <a href="{{ path('admin_billing') }}"            class="admin-nav-link admin-nav-info">Billing</a>
                <a href="{{ path('app_home') }}"                 class="admin-nav-link admin-nav-info">Public</a>
                <a href="{{ path('app_logout') }}"               class="admin-nav-link admin-nav-info">Log Out</a>
            </div>
        </div>
    </nav>

    <div class="admin-content">

        {# ── Alerts ───────────────────────────────────────────────────────── #}
        {% if system_message %}
            <div class="adm-alert adm-alert--{{ message_type == 'danger' ? 'danger' : (message_type == 'warning' ? 'warning' : (message_type == 'success' ? 'success' : 'info')) }}"
                 role="{{ message_type == 'danger' ? 'alert' : 'status' }}">
                <span><strong>&gt; SYSTEM_LOG:</strong> {{ system_message }}</span>
                <button type="button" class="adm-alert-close" data-alert-dismiss aria-label="Dismiss">&times;</button>
            </div>
        {% endif %}
        {% if dashboard_load_error %}
            <div class="adm-alert adm-alert--danger" role="alert">
                Some dashboard records could not be loaded. Check the configured database tables and try again.
            </div>
        {% endif %}

        {# ── Welcome banner ───────────────────────────────────────────────── #}
        <div class="adm-welcome">
            <div>
                <p class="adm-welcome-eyebrow">System Administration &bull; Command Center</p>
                <h1 class="adm-welcome-title">Welcome back, <span>{{ admin_name }}</span></h1>
                <p class="adm-welcome-sub">Execute administrative overrides, manage personnel, and dispatch resources.</p>
            </div>
            <div class="adm-clock-block" aria-live="polite" aria-atomic="true">
                <div class="adm-clock" id="adm-clock">--:--:--</div>
                <div class="adm-date"  id="adm-date">Loading…</div>
                <button type="button" onclick="window.location.reload();" class="adm-btn adm-btn--edit" style="margin-top:8px; display:inline-flex; align-items:center; gap:5px; font-size:0.75rem;" title="Refresh Command Center">
                    <svg style="width:12px; height:12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="23 4 23 10 17 10"></polyline>
                        <polyline points="1 20 1 14 7 14"></polyline>
                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                    </svg>
                    Refresh
                </button>
            </div>
        </div>

        {# ── Stat cards ───────────────────────────────────────────────────── #}
        <section class="adm-stats" aria-label="Dashboard metrics">

            {# Total Users #}
            <article class="adm-stat adm-stat--blue">
                <div class="adm-stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <div class="adm-stat-body">
                    <div class="adm-stat-value">{{ metrics.total_users }}</div>
                    <div class="adm-stat-label">Total Users</div>
                    <a href="{{ path('admin_manage_clients') }}" class="adm-stat-link">Manage Directory &rarr;</a>
                </div>
            </article>

            {# Total Staff #}
            <article class="adm-stat adm-stat--green">
                <div class="adm-stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <div class="adm-stat-body">
                    <div class="adm-stat-value">{{ metrics.total_staff }}</div>
                    <div class="adm-stat-label">Total Staff (Engineers)</div>
                    <a href="#adm-roster-heading" class="adm-stat-link">{{ metrics.available_engineers }} Available &bull; {{ metrics.deployed_engineers }} Deployed</a>
                </div>
            </article>

            {# Total Records #}
            <article class="adm-stat adm-stat--cyan">
                <div class="adm-stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                    </svg>
                </div>
                <div class="adm-stat-body">
                    <div class="adm-stat-value">{{ metrics.total_records }}</div>
                    <div class="adm-stat-label">Total Records</div>
                    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:6px; margin-top:6px;">
                        <a href="{{ path('admin_active_operations') }}" class="adm-stat-link">Operations &amp; Requests &rarr;</a>
                        <button type="button" class="adm-stat-link" data-modal-open="clearHistoryModal" style="background:none; border:none; padding:0; cursor:pointer; color:#f87171;" title="Clear all history">
                            Clear History
                        </button>
                    </div>
                </div>
            </article>

            {# Pending Dispatches #}
            <article class="adm-stat adm-stat--amber">
                <div class="adm-stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                </div>
                <div class="adm-stat-body">
                    <div class="adm-stat-value">{{ metrics.pending_dispatches }}</div>
                    <div class="adm-stat-label">Pending Dispatches</div>
                    <a href="{{ path('admin_pending_dispatch') }}" class="adm-stat-link">Assign Tasks &rarr;</a>
                </div>
            </article>

        </section>

        {# ── Engineer Roster ───────────────────────────────────────────────── #}
        <section class="adm-roster-wrap" aria-labelledby="adm-roster-heading">

            <div class="adm-roster-header">
                <h2 class="adm-roster-title" id="adm-roster-heading">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    Engineer Roster Management
                </h2>
                <button type="button" class="adm-btn adm-btn--primary" data-modal-open="addEngineerModal">
                    <span aria-hidden="true">+</span> Register Personnel
                </button>
            </div>

            <div class="adm-table-scroll">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th scope="col">Personnel Name</th>
                            <th scope="col">Comms (Email)</th>
                            <th scope="col">Specialty</th>
                            <th scope="col">Status</th>
                            <th scope="col">Command</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if engineers is empty %}
                            <tr><td colspan="5" class="adm-empty-row">No engineers found in the database.</td></tr>
                        {% else %}
                            {% for engineer in engineers %}
                                <tr{% if not engineer.is_active %} class="is-suspended"{% endif %}>
                                    <td class="adm-name">{{ engineer.full_name }}</td>
                                    <td class="adm-email">{{ engineer.email }}</td>
                                    <td class="adm-specialty">
                                        {{ engineer.specialty }}
                                        {% if engineer.specialty == 'Chief Engineer' %}
                                            <span style="display:inline-block; margin-left:6px; padding:2px 6px; border-radius:4px; background:rgba(245,158,11,0.2); border:1px solid rgba(245,158,11,0.5); color:#fbbf24; font-size:0.68rem; font-weight:700; text-transform:uppercase;">
                                                Universal Clearance
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if not engineer.is_active %}
                                            <span class="adm-badge adm-badge--danger">Suspended</span>
                                        {% elseif engineer.current_status == 'available' %}
                                            <span class="adm-badge adm-badge--success">Available</span>
                                        {% elseif engineer.current_status == 'deployed' %}
                                            <span class="adm-badge adm-badge--neutral">Deployed</span>
                                        {% else %}
                                            <span class="adm-badge adm-badge--warning">On Leave</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="adm-row-actions">
                                            <button
                                                type="button"
                                                class="adm-btn adm-btn--edit"
                                                data-edit-engineer
                                                data-id="{{ engineer.user_id }}"
                                                data-name="{{ engineer.full_name }}"
                                                data-first-name="{{ engineer.first_name|default('') }}"
                                                data-middle-name="{{ engineer.middle_name|default('') }}"
                                                data-surname="{{ engineer.surname|default('') }}"
                                                data-email="{{ engineer.email }}"
                                                data-specialty="{{ engineer.specialty }}"
                                                data-status="{{ engineer.current_status }}"
                                            >Edit</button>
                                            {% if engineer.is_active %}
                                                <button
                                                    type="button"
                                                    class="adm-btn adm-btn--danger"
                                                    data-delete-engineer
                                                    data-id="{{ engineer.user_id }}"
                                                    data-name="{{ engineer.full_name }}"
                                                >Revoke</button>
                                            {% else %}
                                                <form action="{{ path('admin_dashboard') }}" method="post" class="adm-inline-form" data-confirm-restore data-turbo="false">
                                                    <input type="hidden" name="csrf_token" value="{{ adminCsrfToken }}">
                                                    <input type="hidden" name="action"    value="restore_engineer">
                                                    <input type="hidden" name="user_id"   value="{{ engineer.user_id }}">
                                                    <button type="submit" class="adm-btn adm-btn--restore">Restore</button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </section>

    </div>{# /admin-content #}

    {% include 'admin/_engineer_modals.html.twig' with {
        specialties: specialties,
        statuses: statuses,
        old_post: old_post,
        adminCsrfToken: adminCsrfToken
    } only %}

    {# ── Clear History Modal (Verification) ── #}
    <div class="admin-modal" id="clearHistoryModal" role="dialog" aria-modal="true" aria-labelledby="clearHistoryTitle">
        <div class="admin-modal-dialog">
            <div class="admin-modal-header" style="border-bottom-color: rgba(239, 68, 68, 0.3);">
                <h2 id="clearHistoryTitle" style="color: #f87171;">Clear All History Verification</h2>
                <button type="button" class="admin-modal-close" data-modal-close aria-label="Close modal">&times;</button>
            </div>
            <div class="admin-modal-confirm">
                <div class="admin-confirm-icon">!</div>
                <p>
                    <strong>WARNING:</strong> Are you sure you want to permanently clear all dispatch requests, operational logs, engineer deployments, and invoice history?
                </p>
                <p style="color: #94a3b8; font-size: 0.8rem;">
                    All personnel will be reset to available status. This action cannot be undone.
                </p>
                <form action="{{ path('admin_dashboard') }}" method="post" data-turbo="false" style="margin: 0;">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token('admin_clear_history') }}">
                    <input type="hidden" name="action" value="clear_history">
                    <div class="admin-confirm-actions">
                        <button type="button" class="admin-button admin-button-cancel" data-modal-close>Cancel</button>
                        <button type="submit" class="admin-button admin-button-danger" style="background:#dc2626;">Yes, Clear All History</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</main>

<script>
(function () {
    var DAYS   = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];

    function pad(n) { return n < 10 ? '0' + n : n; }

    function tick() {
        var now = new Date();
        var h = pad(now.getHours());
        var m = pad(now.getMinutes());
        var s = pad(now.getSeconds());
        var clock = document.getElementById('adm-clock');
        var date  = document.getElementById('adm-date');
        if (clock) clock.textContent = h + ':' + m + ':' + s;
        if (date)  date.textContent  = DAYS[now.getDay()] + ', ' + MONTHS[now.getMonth()] + ' ' + now.getDate() + ', ' + now.getFullYear();
    }

    tick();
    setInterval(tick, 1000);

})();

/* ── Embedded Modal Controller (Robust Turbo & DOM lifecycle) ─────────────── */
(function () {
    var activeModal = null;

    function openModal(modal, trigger) {
        if (!modal) return;
        activeModal = modal;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        var firstInput = modal.querySelector('input:not([type="hidden"]), select, button');
        if (firstInput) firstInput.focus();
        if (trigger) trigger.blur();
    }

    function closeModal() {
        if (!activeModal) return;
        activeModal.classList.remove('is-open');
        activeModal.setAttribute('aria-hidden', 'true');
        activeModal = null;
    }

    function initAdminDashboard() {
        var adminPage = document.querySelector('.admin-page');
        if (!adminPage) return;

        // Open modal via [data-modal-open]
        adminPage.querySelectorAll('[data-modal-open]').forEach(function (button) {
            button.onclick = function (e) {
                e.preventDefault();
                var targetId = button.getAttribute('data-modal-open');
                var targetModal = document.getElementById(targetId);
                if (targetModal) openModal(targetModal, button);
            };
        });

        // Dismiss via [data-modal-dismiss]
        adminPage.querySelectorAll('[data-modal-dismiss]').forEach(function (button) {
            button.onclick = function (e) {
                e.preventDefault();
                closeModal();
            };
        });

        // Backdrop click closes modal
        adminPage.querySelectorAll('.admin-modal').forEach(function (modal) {
            modal.onclick = function (event) {
                if (event.target === modal) closeModal();
            };
        });

        // Edit engineer button → populate + open edit modal
        adminPage.querySelectorAll('[data-edit-engineer]').forEach(function (button) {
            button.onclick = function (e) {
                e.preventDefault();
                var editId = document.getElementById('edit_user_id');
                var editFirstName = document.getElementById('edit_eng_first_name');
                var editMiddleName = document.getElementById('edit_eng_middle_name');
                var editSurname = document.getElementById('edit_eng_surname');
                var editEmail = document.getElementById('edit_eng_email');
                var editSpecialty = document.getElementById('edit_eng_specialty');
                var editStatus = document.getElementById('edit_eng_status');

                if (editId) editId.value = button.dataset.id || '';
                if (editFirstName) editFirstName.value = button.dataset.firstName || '';
                if (editMiddleName) editMiddleName.value = button.dataset.middleName || '';
                if (editSurname) editSurname.value = button.dataset.surname || '';
                if (editEmail) editEmail.value = button.dataset.email || '';
                if (editSpecialty) editSpecialty.value = button.dataset.specialty || '';
                if (editStatus) editStatus.value = button.dataset.status || 'available';
                openModal(document.getElementById('editEngineerModal'), button);
            };
        });

        // Revoke/delete engineer button → populate + open delete modal
        adminPage.querySelectorAll('[data-delete-engineer]').forEach(function (button) {
            button.onclick = function (e) {
                e.preventDefault();
                var deleteId = document.getElementById('delete_user_id');
                var deleteDisplay = document.getElementById('delete_eng_name_display');
                if (deleteId) deleteId.value = button.dataset.id || '';
                if (deleteDisplay) deleteDisplay.textContent = button.dataset.name || '';
                openModal(document.getElementById('deleteEngineerModal'), button);
            };
        });

        // Auto-reopen modal if there was a previous failure
        var failedAction = adminPage.dataset.failedAction;
        if (failedAction === 'add_engineer') {
            openModal(document.getElementById('addEngineerModal'));
        } else if (failedAction === 'edit_engineer') {
            openModal(document.getElementById('editEngineerModal'));
        }
    }

    // Escape key closes modal
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && activeModal) closeModal();
    });

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAdminDashboard);
    } else {
        initAdminDashboard();
    }
    document.addEventListener('turbo:load', initAdminDashboard);
    document.addEventListener('turbo:render', initAdminDashboard);
})();
</script>
{% endblock %}
