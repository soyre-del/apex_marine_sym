{% extends 'base.html.twig' %}

{% block title %}Client Registry | Apex Marine{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/manage_clients.css') }}">
    <style>
        .adm-password-wrap {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }
        .adm-password-wrap .clients-control {
            padding-right: 5.2rem !important;
        }
        .adm-password-toggle {
            position: absolute;
            top: 50%;
            right: .55rem;
            transform: translateY(-50%);
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            padding: .3rem .58rem;
            border: 1px solid rgba(11, 165, 223, .32);
            border-radius: 6px;
            background: rgba(11, 165, 223, .12);
            color: #70d7fa;
            font-family: inherit;
            font-size: .74rem;
            font-weight: 600;
            letter-spacing: .02em;
            text-transform: none;
            cursor: pointer;
            z-index: 2;
            transition: background-color .15s ease, border-color .15s ease, color .15s ease;
        }
        .adm-password-toggle:hover {
            background: rgba(11, 165, 223, .24);
            border-color: rgba(11, 165, 223, .6);
            color: #ffffff;
        }
    </style>
{% endblock %}

{% block body %}
    {% set clientCsrfToken = csrf_token('admin_clients') %}
    <main class="clients-page">
        <nav class="clients-nav" aria-label="Client management navigation">
            <div class="clients-nav-inner">
                <div class="clients-brand">
                    <span class="clients-system-pill">CLIENT_DB</span>
                    <strong>Apex Marine</strong>
                </div>
                <a href="{{ path('admin_dashboard') }}" class="clients-button clients-button-outline">
                    &larr; Back to Matrix
                </a>
            </div>
        </nav>

        <div class="clients-content">
            {% for message in app.flashes('success') %}
                <div class="clients-alert clients-alert-success" role="status">
                    <strong>&gt; SYSTEM_LOG:</strong> {{ message }}
                    <button type="button" class="clients-alert-close" data-clients-alert-close aria-label="Dismiss">&times;</button>
                </div>
            {% endfor %}
            {% for message in app.flashes('warning') %}
                <div class="clients-alert clients-alert-warning" role="alert">
                    <strong>&gt; SYSTEM_LOG:</strong> {{ message }}
                    <button type="button" class="clients-alert-close" data-clients-alert-close aria-label="Dismiss">&times;</button>
                </div>
            {% endfor %}
            {% for message in app.flashes('danger') %}
                <div class="clients-alert clients-alert-danger" role="alert">
                    <strong>&gt; SYSTEM_LOG:</strong> {{ message }}
                    <button type="button" class="clients-alert-close" data-clients-alert-close aria-label="Dismiss">&times;</button>
                </div>
            {% endfor %}

            {% if clients_load_error %}
                <div class="clients-alert clients-alert-danger" role="alert">
                    Unable to load the client roster. Check that the required database tables and columns are available.
                </div>
            {% endif %}

            <section class="clients-roster" aria-labelledby="clients-title">
                <header class="clients-roster-heading">
                    <div>
                        <h1 id="clients-title">Client Authorization Roster</h1>
                        <p>Manage access levels and monitor organizational dispatch metrics.</p>
                    </div>
                    <button type="button" class="clients-button clients-button-info" data-clients-open="addClientModal">
                        <span aria-hidden="true">+</span> Register New Client
                    </button>
                </header>

                <div class="clients-table-wrap">
                    <table class="clients-table">
                        <thead>
                            <tr>
                                <th scope="col">Account &amp; Organization</th>
                                <th scope="col">Contact Information</th>
                                <th scope="col" class="clients-center">Dispatch Metrics</th>
                                <th scope="col">Status</th>
                                <th scope="col" class="clients-right">Command</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for client in clients %}
                                <tr{% if not client.is_active %} class="is-suspended"{% endif %}>
                                    <td>
                                        <strong class="clients-name">{{ client.full_name }}</strong>
                                        {% if client.username is defined and client.username %}
                                            <span class="clients-muted" style="color:#70d7fa;">@{{ client.username }}</span>
                                        {% endif %}
                                        {% if client.latest_company %}
                                            <span class="clients-company">{{ client.latest_company }}</span>
                                        {% else %}
                                            <span class="clients-muted">No Company Logged</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="clients-email">{{ client.email }}</span>
                                        {% if client.latest_contact_person %}
                                            <span class="clients-contact">POC: {{ client.latest_contact_person }}</span>
                                        {% endif %}
                                        {% if client.latest_contact_phone %}
                                            <span class="clients-phone">&#9742; {{ client.latest_contact_phone }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="clients-center">
                                        {% if client.active_dispatches > 0 %}
                                            <span class="clients-active-ops">{{ client.active_dispatches }} Active Ops</span>
                                        {% else %}
                                            <span class="clients-muted clients-zero-ops">0 Active Ops</span>
                                        {% endif %}
                                        <span class="clients-total">{{ client.total_dispatches }} Total Lifetime</span>
                                    </td>
                                    <td>
                                        {% if client.is_active %}
                                            <span class="clients-status clients-status-active">Active</span>
                                        {% else %}
                                            <span class="clients-status clients-status-suspended">Suspended</span>
                                        {% endif %}
                                    </td>
                                    <td class="clients-right">
                                        <div class="clients-actions">
                                            <button type="button" class="clients-button clients-button-small clients-button-edit"
                                                    data-clients-edit
                                                    data-id="{{ client.user_id }}"
                                                    data-username="{{ client.username|default('') }}"
                                                    data-first-name="{{ client.first_name|default('') }}"
                                                    data-middle-name="{{ client.middle_name|default('') }}"
                                                    data-surname="{{ client.surname|default('') }}"
                                                    data-name="{{ client.full_name }}"
                                                    data-email="{{ client.email }}">
                                                Edit
                                            </button>

                                            <form action="{{ path('admin_manage_clients') }}" method="post" class="clients-inline-form" data-turbo="false">
                                                <input type="hidden" name="csrf_token" value="{{ clientCsrfToken }}">
                                                <input type="hidden" name="action" value="toggle_status">
                                                <input type="hidden" name="client_id" value="{{ client.user_id }}">
                                                <input type="hidden" name="new_status" value="{{ client.is_active ? '0' : '1' }}">
                                                {% if client.is_active %}
                                                    <button type="button" class="clients-button clients-button-small clients-button-suspend"
                                                            data-clients-toggle data-status="0" data-name="{{ client.full_name }}">
                                                        Suspend
                                                    </button>
                                                {% else %}
                                                    <button type="button" class="clients-button clients-button-small clients-button-restore"
                                                            data-clients-toggle data-status="1" data-name="{{ client.full_name }}">
                                                        Restore
                                                    </button>
                                                {% endif %}
                                            </form>

                                            <button type="button" class="clients-button clients-button-small clients-button-purge"
                                                    data-clients-purge data-id="{{ client.user_id }}" data-name="{{ client.full_name }}">
                                                Purge
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="clients-empty">No client profiles detected in the sector.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="clients-modal" id="addClientModal" aria-hidden="true">
            <section class="clients-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="addClientTitle">
                <header class="clients-modal-header">
                    <h2 id="addClientTitle">Initialize Profile</h2>
                    <button type="button" class="clients-modal-close" data-clients-close aria-label="Close">&times;</button>
                </header>
                <form action="{{ path('admin_manage_clients') }}" method="post" data-turbo="false">
                    <div class="clients-modal-body">
                        <input type="hidden" name="csrf_token" value="{{ clientCsrfToken }}">
                        <input type="hidden" name="action" value="add_client">
                        <label class="clients-label">Username <span style="color:#ff8585;">*</span>
                            <input type="text" name="client_username" required class="clients-control" placeholder="e.g. juan_cruz" autocomplete="username">
                        </label>
                        <label class="clients-label">First Name <span style="color:#ff8585;">*</span>
                            <input type="text" name="client_first_name" required class="clients-control" placeholder="First Name" autocomplete="given-name" data-capitalize-name>
                        </label>
                        <label class="clients-label">Middle Name <span style="color:#8199ae; font-weight:400; text-transform:none;">(Optional)</span>
                            <input type="text" name="client_middle_name" class="clients-control" placeholder="Middle Name (Optional)" autocomplete="additional-name" data-capitalize-name>
                        </label>
                        <label class="clients-label">Surname <span style="color:#ff8585;">*</span>
                            <input type="text" name="client_surname" required class="clients-control" placeholder="Surname" autocomplete="family-name" data-capitalize-name>
                        </label>
                        <label class="clients-label">Secure Email <span style="color:#ff8585;">*</span>
                            <input type="email" name="client_email" required class="clients-control" autocomplete="email">
                        </label>
                        <label class="clients-label">Temporary Password
                            <div class="adm-password-wrap">
                                <input type="password" name="client_password" id="add_client_password" required minlength="8" maxlength="128" class="clients-control"
                                       placeholder="Min. 8 chars, upper, lower, number &amp; symbol" autocomplete="new-password">
                                <button type="button" class="adm-password-toggle" data-adm-password-toggle aria-label="Show password" aria-pressed="false">
                                    <svg class="icon-eye" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    <svg class="icon-eye-off" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                        <line x1="1" y1="1" x2="23" y2="23"/>
                                    </svg>
                                    <span class="adm-password-toggle-text">Show</span>
                                </button>
                            </div>
                            <small style="color:#8da2b5; font-size:0.72rem; text-transform:none; letter-spacing:normal; font-weight:400;">Must include 8+ characters, uppercase, lowercase, number, and special character.</small>
                        </label>
                    </div>
                    <footer class="clients-modal-footer">
                        <button type="button" class="clients-button clients-button-outline" data-clients-close>Cancel</button>
                        <button type="submit" class="clients-button clients-button-info">Grant System Access</button>
                    </footer>
                </form>
            </section>
        </div>

        <div class="clients-modal" id="editClientModal" aria-hidden="true">
            <section class="clients-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="editClientTitle">
                <header class="clients-modal-header">
                    <h2 id="editClientTitle">Modify Profile</h2>
                    <button type="button" class="clients-modal-close" data-clients-close aria-label="Close">&times;</button>
                </header>
                <form action="{{ path('admin_manage_clients') }}" method="post" data-turbo="false">
                    <div class="clients-modal-body">
                        <input type="hidden" name="csrf_token" value="{{ clientCsrfToken }}">
                        <input type="hidden" name="action" value="edit_client">
                        <input type="hidden" name="client_id" id="edit_client_id">
                        <label class="clients-label">Username <span style="color:#8199ae; font-weight:400; text-transform:none;">(Client Editable Only)</span>
                            <input type="text" id="edit_username_display" class="clients-control" readonly disabled style="opacity:0.65; cursor:not-allowed;">
                        </label>
                        <label class="clients-label">First Name <span style="color:#ff8585;">*</span>
                            <input type="text" name="edit_first_name" id="edit_first_name" required class="clients-control" autocomplete="given-name" data-capitalize-name>
                        </label>
                        <label class="clients-label">Middle Name <span style="color:#8199ae; font-weight:400; text-transform:none;">(Optional)</span>
                            <input type="text" name="edit_middle_name" id="edit_middle_name" class="clients-control" placeholder="Optional" autocomplete="additional-name" data-capitalize-name>
                        </label>
                        <label class="clients-label">Surname <span style="color:#ff8585;">*</span>
                            <input type="text" name="edit_surname" id="edit_surname" required class="clients-control" autocomplete="family-name" data-capitalize-name>
                        </label>
                        <label class="clients-label">Secure Email <span style="color:#ff8585;">*</span>
                            <input type="email" name="edit_email" id="edit_email" required class="clients-control" autocomplete="email">
                        </label>
                        <label class="clients-label">Reset Password (Optional)
                            <div class="adm-password-wrap">
                                <input type="password" name="edit_password" id="edit_client_password" minlength="8" class="clients-control"
                                       placeholder="Leave blank to keep current" autocomplete="new-password">
                                <button type="button" class="adm-password-toggle" data-adm-password-toggle aria-label="Show password" aria-pressed="false">
                                    <svg class="icon-eye" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    <svg class="icon-eye-off" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                        <line x1="1" y1="1" x2="23" y2="23"/>
                                    </svg>
                                    <span class="adm-password-toggle-text">Show</span>
                                </button>
                            </div>
                        </label>
                    </div>
                    <footer class="clients-modal-footer">
                        <button type="button" class="clients-button clients-button-outline" data-clients-close>Cancel</button>
                        <button type="submit" class="clients-button clients-button-info">Save Modifications</button>
                    </footer>
                </form>
            </section>
        </div>

        <div class="clients-modal" id="purgeClientModal" aria-hidden="true">
            <section class="clients-modal-dialog clients-modal-danger" role="dialog" aria-modal="true" aria-labelledby="purgeClientTitle">
                <header class="clients-modal-header">
                    <h2 id="purgeClientTitle">Critical: Purge Account?</h2>
                    <button type="button" class="clients-modal-close" data-clients-close aria-label="Close">&times;</button>
                </header>
                <div class="clients-modal-body clients-modal-confirm">
                    <p>
                        This permanently deletes <strong id="purge_client_name_display"></strong>'s account along with all connected dispatch requests, deployment records, operation timeline logs, and billing history.
                    </p>
                    <form action="{{ path('admin_manage_clients') }}" method="post" class="clients-modal-footer" data-turbo="false">
                        <input type="hidden" name="csrf_token" value="{{ clientCsrfToken }}">
                        <input type="hidden" name="action" value="hard_delete_client">
                        <input type="hidden" name="client_id" id="purge_user_id">
                        <button type="button" class="clients-button clients-button-outline" data-clients-close>Cancel</button>
                        <button type="submit" class="clients-button clients-button-purge">Execute Purge</button>
                    </form>
                </div>
            </section>
        </div>

        <div class="clients-modal" id="statusToggleModal" aria-hidden="true">
            <section class="clients-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="statusToggleTitle">
                <header class="clients-modal-header">
                    <h2 id="statusToggleTitle">Confirm Action</h2>
                    <button type="button" class="clients-modal-close" data-clients-close aria-label="Close">&times;</button>
                </header>
                <div class="clients-modal-body clients-modal-confirm">
                    <p id="statusToggleMessage">Are you sure?</p>
                    <div class="clients-modal-footer">
                        <button type="button" class="clients-button clients-button-outline" data-clients-close>Cancel</button>
                        <button type="button" class="clients-button clients-button-info" id="confirmToggleBtn">Proceed</button>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script>
    (function () {
        function bindClientPasswordToggles() {
            document.querySelectorAll('[data-adm-password-toggle]').forEach(function (btn) {
                if (btn.dataset.toggleBound === 'true') {
                    return;
                }
                btn.dataset.toggleBound = 'true';

                btn.addEventListener('click', function () {
                    var wrap = btn.closest('.adm-password-wrap');
                    if (!wrap) return;
                    var input = wrap.querySelector('input');
                    if (!input) return;

                    var isHidden = input.type === 'password';
                    input.type = isHidden ? 'text' : 'password';
                    btn.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
                    btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');

                    var eyeIcon = btn.querySelector('.icon-eye');
                    var eyeOffIcon = btn.querySelector('.icon-eye-off');
                    var textSpan = btn.querySelector('.adm-password-toggle-text');

                    if (eyeIcon) eyeIcon.hidden = isHidden;
                    if (eyeOffIcon) eyeOffIcon.hidden = !isHidden;
                    if (textSpan) textSpan.textContent = isHidden ? 'Hide' : 'Show';
                });
            });

            var capName = function (v) {
                return v.replace(/(^|[\s'-])(\p{Ll})/gu, function (m, sep, ch) {
                    return sep + ch.toLocaleUpperCase();
                });
            };
            document.querySelectorAll('[data-capitalize-name]').forEach(function (field) {
                if (field.dataset.capBound === 'true') return;
                field.dataset.capBound = 'true';
                field.addEventListener('input', function () {
                    var s = field.selectionStart, e = field.selectionEnd;
                    var next = capName(field.value);
                    if (next !== field.value) {
                        field.value = next;
                        if (s !== null) field.setSelectionRange(s, e);
                    }
                });
                field.addEventListener('blur', function () {
                    field.value = capName(field.value.replace(/\s+/g, ' ').trim());
                });
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bindClientPasswordToggles);
        } else {
            bindClientPasswordToggles();
        }
        document.addEventListener('turbo:load', bindClientPasswordToggles);
        document.addEventListener('turbo:render', bindClientPasswordToggles);
    })();
    </script>

{% endblock %}
