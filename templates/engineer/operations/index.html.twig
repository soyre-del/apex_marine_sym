{% extends 'dashboard/index.html.twig' %}

{% block title %}Field Operations | {{ configuration.sidebar.brand }}{% endblock %}
{% block meta_description %}Manage assigned field operations and report updates to clients.{% endblock %}
{% block main_class %}engineer-main{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/engineer_operations.css') }}">
    <style>
        /* ── Engineer welcome / stat section ───────────────────────────── */
        .eng-welcome {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1.25rem;
            background: linear-gradient(135deg, #122d47 0%, #0e2b49 65%, #081c2d 100%);
            border: 1px solid #23415d;
            border-radius: 14px;
            padding: 1.75rem 2rem;
            margin-bottom: 1.75rem;
            position: relative;
            overflow: hidden;
        }
        .eng-welcome::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 55% 90% at 100% 50%, rgba(11,165,223,.13) 0%, transparent 65%);
            pointer-events: none;
        }
        .eng-welcome-left { flex: 1; min-width: 0; }
        .eng-welcome-eyebrow {
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: #0ba5df;
            margin: 0 0 .3rem;
        }
        .eng-welcome-title {
            font-size: 1.45rem;
            font-weight: 700;
            color: #f0f5ff;
            margin: 0 0 .4rem;
            line-height: 1.25;
        }
        .eng-welcome-title span { color: #0ba5df; }
        .eng-welcome-date {
            font-size: .8rem;
            color: #a3b6c8;
            margin: 0;
        }
        .eng-status-badge {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: .35rem .9rem;
            border-radius: 999px;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .07em;
            text-transform: uppercase;
            flex-shrink: 0;
            align-self: flex-start;
        }
        .eng-status-badge::before {
            content: '';
            width: 7px; height: 7px;
            border-radius: 50%;
            background: currentColor;
            animation: eng-pulse 2s infinite;
        }
        @keyframes eng-pulse {
            0%, 100% { opacity: 1; box-shadow: 0 0 0 0 currentColor; }
            50% { opacity: .5; box-shadow: 0 0 0 4px transparent; }
        }
        .eng-status-badge--active {
            background: rgba(16,185,129,.15);
            color: #34d399;
        }
        .eng-status-badge--idle {
            background: rgba(163,182,200,.12);
            color: #a3b6c8;
        }

        /* ── Mini stat cards ───────────────────────────────────────────── */
        .eng-mini-stats {
            display: flex;
            gap: .9rem;
            flex-wrap: wrap;
        }
        .eng-mini-card {
            display: flex;
            align-items: center;
            gap: .8rem;
            background: #0e2b49;
            border: 1px solid #23415d;
            border-radius: 10px;
            padding: .9rem 1.1rem;
            min-width: 120px;
            position: relative;
            transition: transform .18s, box-shadow .18s;
        }
        .eng-mini-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,.3);
        }
        .eng-mini-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            border-radius: 10px 10px 0 0;
            background: var(--eng-accent, #0ba5df);
        }
        .eng-mini-icon {
            width: 36px; height: 36px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            background: #081c2d;
            color: var(--eng-accent, #0ba5df);
            flex-shrink: 0;
        }
        .eng-mini-icon svg { width: 18px; height: 18px; }
        .eng-mini-body { }
        .eng-mini-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: #f0f5ff;
            line-height: 1;
        }
        .eng-mini-label {
            font-size: .68rem;
            font-weight: 600;
            letter-spacing: .07em;
            text-transform: uppercase;
            color: #a3b6c8;
            margin-top: .15rem;
        }
        .eng-mini-card--total  { --eng-accent: #0ba5df; }
        .eng-mini-card--route  { --eng-accent: #f59e0b; }
        .eng-mini-card--active { --eng-accent: #10b981; }

        @media (max-width: 600px) {
            .eng-welcome { padding: 1.25rem; }
            .eng-welcome-title { font-size: 1.15rem; }
            .eng-mini-stats { gap: .6rem; }
            .eng-mini-card { min-width: 100px; padding: .75rem .9rem; }
        }
    </style>
{% endblock %}

{% block page_content %}
    <div class="engineer-operations-page">
        <div class="engineer-glow engineer-glow-blue"  aria-hidden="true"></div>
        <div class="engineer-glow engineer-glow-ocean" aria-hidden="true"></div>

        <div class="engineer-content">

            {# ── Welcome & stat section ──────────────────────────────────── #}
            <div class="eng-welcome" aria-label="Engineer overview">
                <div class="eng-welcome-left">
                    <p class="eng-welcome-eyebrow">
                        {% if engineer_specialty is defined and 'chief engineer' in engineer_specialty|lower %}
                            <span style="color:#fbbf24; font-weight:700;">Chief Engineer &bull; Universal Technical Authority</span>
                        {% else %}
                            Field Operations &bull; Active Deployment Protocol
                        {% endif %}
                    </p>
                    <h1 class="eng-welcome-title">
                        Welcome, <span>{{ engineer_name }}</span>
                    </h1>
                    <p class="eng-welcome-date" id="eng-date">Loading…</p>
                </div>

                {# Status badge #}
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    {% if engineer_specialty is defined and 'chief engineer' in engineer_specialty|lower %}
                        <span class="eng-status-badge" style="background:rgba(245,158,11,0.25); color:#fbbf24; border:1px solid rgba(245,158,11,0.6);">
                            Universal Clearance (All Disciplines)
                        </span>
                    {% elseif engineer_specialty is defined and engineer_specialty %}
                        <span class="eng-status-badge" style="background:rgba(11,165,223,0.15); color:#38bdf8; border:1px solid rgba(11,165,223,0.4);">
                            {{ engineer_specialty }}
                        </span>
                    {% endif %}
                    {% if total_tasks > 0 %}
                        <span class="eng-status-badge eng-status-badge--active">On Deployment</span>
                    {% else %}
                        <span class="eng-status-badge eng-status-badge--idle">Standby</span>
                    {% endif %}
                    <a href="{{ path('app_profile') }}" class="eng-status-badge" style="background:rgba(11,165,223,0.18); color:#70d7fa; border:1px solid rgba(11,165,223,0.45); text-decoration:none;">
                        My Profile
                    </a>
                </div>

                {# Mini stat cards – full width row below the header text #}
                <div class="eng-mini-stats" style="flex-basis:100%;">

                    <div class="eng-mini-card eng-mini-card--total">
                        <div class="eng-mini-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                        </div>
                        <div class="eng-mini-body">
                            <div class="eng-mini-value">{{ total_tasks }}</div>
                            <div class="eng-mini-label">Total Assigned</div>
                        </div>
                    </div>

                    <div class="eng-mini-card eng-mini-card--route">
                        <div class="eng-mini-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"/><path d="M12 8l4 4-4 4"/><path d="M8 12h8"/>
                            </svg>
                        </div>
                        <div class="eng-mini-body">
                            <div class="eng-mini-value">{{ pending_tasks }}</div>
                            <div class="eng-mini-label">En Route</div>
                        </div>
                    </div>

                    <div class="eng-mini-card eng-mini-card--active">
                        <div class="eng-mini-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                        </div>
                        <div class="eng-mini-body">
                            <div class="eng-mini-value">{{ in_progress_tasks }}</div>
                            <div class="eng-mini-label">Active (On Site)</div>
                        </div>
                    </div>

                </div>
            </div>
            {# /eng-welcome #}

            {# ── Existing page header ─────────────────────────────────── #}
            <header class="engineer-page-heading">
                <div>
                    <p class="engineer-eyebrow">Field Operations</p>
                    <h2 style="margin:0;font-size:1.15rem;font-weight:700;color:#f0f5ff;">Active Deployment Protocol</h2>
                    <p>Review assigned technical interventions and log updates directly to the client timeline.</p>
                </div>
            </header>

            {# ── Flash messages ───────────────────────────────────────── #}
            {% for message in app.flashes('success') %}
                <div class="engineer-alert engineer-alert-success" role="status">
                    {{ message }}
                    <button type="button" class="engineer-alert-close" data-engineer-alert-close aria-label="Dismiss">&times;</button>
                </div>
            {% endfor %}
            {% for message in app.flashes('warning') %}
                <div class="engineer-alert engineer-alert-warning" role="alert">
                    {{ message }}
                    <button type="button" class="engineer-alert-close" data-engineer-alert-close aria-label="Dismiss">&times;</button>
                </div>
            {% endfor %}
            {% for message in app.flashes('danger') %}
                <div class="engineer-alert engineer-alert-danger" role="alert">
                    {{ message }}
                    <button type="button" class="engineer-alert-close" data-engineer-alert-close aria-label="Dismiss">&times;</button>
                </div>
            {% endfor %}

            {# ── Task list ────────────────────────────────────────────── #}
            {% if load_error %}
                <div class="engineer-alert engineer-alert-danger" role="alert">
                    Unable to load your assignments right now. Please try again later.
                </div>
            {% elseif tasks is empty %}
                <section class="engineer-empty">
                    <h2>No Active Assignments</h2>
                    <p>You are currently cleared of all tasks. Stand by for deployment orders.</p>
                </section>
            {% else %}
                <section class="engineer-task-grid" aria-label="Assigned field operations">
                    {% for task in tasks %}
                        <article class="engineer-task-card">
                            <header class="engineer-task-header">
                                <span class="engineer-request-id">REQ-{{ '%04d'|format(task.request_id) }}</span>
                                {% if task.status == 'in_progress' %}
                                    <span class="engineer-task-status is-active"><span></span> On Site / Active</span>
                                {% else %}
                                    <span class="engineer-task-status is-en-route"><span></span> En Route</span>
                                {% endif %}
                            </header>

                            <h2>{{ task.vessel_name }}</h2>
                            <p class="engineer-company">{{ task.company|default('Private Client') }}</p>
                            <p class="engineer-description">{{ task.description|nl2br }}</p>

                            <footer class="engineer-task-footer">
                                <div>
                                    <span>Time Logged</span>
                                    <time datetime="{{ task.requested_at|date('c') }}">{{ task.requested_at|date('M d, Y - H:i') }}</time>
                                </div>
                                <button type="button" class="engineer-button engineer-button-outline"
                                        data-engineer-open-log
                                        data-request-id="{{ task.request_id }}"
                                        data-vessel="{{ task.vessel_name }}"
                                        data-status="{{ task.status }}">
                                    Update Log
                                </button>
                            </footer>
                        </article>
                    {% endfor %}
                </section>
            {% endif %}

            {# ── My Submitted Operation Logs (Edit Own Records) ────────── #}
            {% if my_updates is defined and my_updates is not empty %}
                <section style="margin-top: 2.5rem;" aria-label="My logged updates">
                    <header style="margin-bottom: 1.25rem;">
                        <p class="engineer-eyebrow" style="color:#0ba5df;">Activity Log &bull; Staff Records</p>
                        <h2 style="margin:0 0 .3rem; font-size:1.25rem; font-weight:700; color:#f0f5ff;">My Submitted Operation Logs</h2>
                        <p style="margin:0; font-size:.82rem; color:#a3b6c8;">Review and modify previous milestone updates submitted by your operative ID.</p>
                    </header>
                    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:1.2rem;">
                        {% for update in my_updates %}
                            <article class="engineer-task-card" style="padding:1.4rem;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.75rem;">
                                    <span class="engineer-request-id" style="font-size:.72rem;">REQ-{{ '%04d'|format(update.request_id) }} &bull; {{ update.vessel_name }}</span>
                                    <time style="font-size:.75rem; color:#a3b6c8;" datetime="{{ update.logged_at|date('c') }}">{{ update.logged_at|date('M d, H:i') }}</time>
                                </div>
                                <h3 style="font-size:1.05rem; font-weight:700; color:#f0f5ff; margin:0 0 .4rem;">{{ update.status_milestone }}</h3>
                                <p style="font-size:.85rem; color:#a3b6c8; line-height:1.5; margin:0 0 1rem; word-break:break-word;">{{ update.detailed_message }}</p>
                                <div style="display:flex; gap:0.6rem; flex-wrap:wrap;">
                                    <button type="button" class="engineer-button engineer-button-outline"
                                            style="font-size:.8rem; padding:.45rem .9rem; border-color:rgba(11,165,223,.4); color:#0ba5df;"
                                            data-edit-my-log
                                            data-update-id="{{ update.update_id }}"
                                            data-vessel="{{ update.vessel_name }}"
                                            data-milestone="{{ update.status_milestone }}"
                                            data-details="{{ update.detailed_message }}">
                                        Edit My Log
                                    </button>
                                    <button type="button" class="engineer-button engineer-button-outline"
                                            style="font-size:.8rem; padding:.45rem .9rem; border-color:rgba(239,68,68,.4); color:#ef4444;"
                                            data-delete-my-log
                                            data-update-id="{{ update.update_id }}"
                                            data-vessel="{{ update.vessel_name }}"
                                            data-milestone="{{ update.status_milestone }}">
                                        Retract Log
                                    </button>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        </div>{# /engineer-content #}

        {# ── Operations log modal ─────────────────────────────────────── #}
        <div class="engineer-modal" data-engineer-modal aria-hidden="true">
            <section class="engineer-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="engineer-modal-title">
                <header class="engineer-modal-header">
                    <h2 id="engineer-modal-title">Submit Operations Log</h2>
                    <button type="button" class="engineer-modal-close" data-engineer-close aria-label="Close">&times;</button>
                </header>
                <form method="post" action="{{ path('engineer_operations') }}">
                    <div class="engineer-modal-body">
                        <input type="hidden" name="csrf_token"  value="{{ csrf_token('engineer_task_update') }}">
                        <input type="hidden" name="action"      value="update_task_status">
                        <input type="hidden" name="request_id"  data-engineer-request-id>

                        <div class="engineer-target">
                            <span>Target Vessel</span>
                            <strong data-engineer-vessel></strong>
                        </div>

                        <label class="engineer-label" for="engineer-status">
                            New Operational Status
                            <select id="engineer-status" name="new_status" class="engineer-control" required>
                                <option value="deployed">Deployed (En Route)</option>
                                <option value="acknowledged">Acknowledged (Reviewed)</option>
                                <option value="pending">Pending (Awaiting Action)</option>
                                <option value="in_progress">In Progress (On Site)</option>
                                <option value="resolved">Resolved / Completed</option>
                                <option value="cancelled">Cancelled</option>
                            </select>
                        </label>

                        <label class="engineer-label" for="engineer-milestone">
                            Status Milestone (Short Summary)
                            <input id="engineer-milestone" type="text" name="milestone" class="engineer-control"
                                   placeholder="e.g. Engineer Arrived on Site" required>
                        </label>

                        <label class="engineer-label" for="engineer-details">
                            Detailed Log Message (Visible to Client)
                            <textarea id="engineer-details" name="details" rows="4" class="engineer-control"
                                      placeholder="Provide technical details regarding the current state of repairs..." required></textarea>
                        </label>
                    </div>
                    <footer class="engineer-modal-footer">
                        <button type="button" class="engineer-button engineer-button-outline" data-engineer-close>Cancel</button>
                        <button type="submit" class="engineer-button engineer-button-primary">Transmit Update</button>
                    </footer>
                </form>
            </section>
        </div>

        {# ── Edit Own Log Modal (Staff: Edit Own Records) ───────────────── #}
        <div class="engineer-modal" id="editOwnUpdateModal" aria-hidden="true">
            <section class="engineer-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="edit-update-title">
                <header class="engineer-modal-header">
                    <h2 id="edit-update-title">Edit My Operation Log</h2>
                    <button type="button" class="engineer-modal-close" data-close-edit-modal aria-label="Close">&times;</button>
                </header>
                <form method="post" action="{{ path('engineer_operations') }}">
                    <div class="engineer-modal-body">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token('engineer_edit_update') }}">
                        <input type="hidden" name="action" value="edit_own_update">
                        <input type="hidden" name="update_id" id="edit-log-update-id">

                        <div class="engineer-target">
                            <span>Vessel Reference</span>
                            <strong id="edit-log-vessel"></strong>
                        </div>

                        <label class="engineer-label" for="edit-log-milestone">
                            Status Milestone (Short Summary)
                            <input id="edit-log-milestone" type="text" name="milestone" class="engineer-control" required>
                        </label>

                        <label class="engineer-label" for="edit-log-details">
                            Detailed Log Message
                            <textarea id="edit-log-details" name="details" rows="4" class="engineer-control" required></textarea>
                        </label>
                    </div>
                    <footer class="engineer-modal-footer">
                        <button type="button" class="engineer-button engineer-button-outline" data-close-edit-modal>Cancel</button>
                        <button type="submit" class="engineer-button engineer-button-primary">Save Changes</button>
                    </footer>
                </form>
            </section>
        </div>

        {# ── Retract / Delete Own Log Modal (Staff: Delete with Confirmation) ── #}
        <div class="engineer-modal" id="deleteOwnUpdateModal" aria-hidden="true">
            <section class="engineer-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-update-title" style="max-width: 480px;">
                <header class="engineer-modal-header" style="border-bottom-color: rgba(239, 68, 68, 0.3);">
                    <h2 id="delete-update-title" style="color: #ef4444; display: flex; align-items: center; gap: 8px;">
                        Confirm Log Retraction
                    </h2>
                    <button type="button" class="engineer-modal-close" data-close-delete-modal aria-label="Close">&times;</button>
                </header>
                <form method="post" action="{{ path('engineer_operations') }}">
                    <div class="engineer-modal-body">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token('engineer_delete_update') }}">
                        <input type="hidden" name="action" value="delete_own_update">
                        <input type="hidden" name="update_id" id="delete-log-update-id">

                        <p style="color: #f0f5ff; font-size: 0.95rem; margin-bottom: 0.75rem;">
                            Are you sure you want to retract and permanently delete this operational log entry?
                        </p>
                        <div class="engineer-target" style="border-left: 3px solid #ef4444; background: rgba(239, 68, 68, 0.08);">
                            <span id="delete-log-vessel" style="color: #a3b6c8; display: block; font-size: 0.8rem;"></span>
                            <strong id="delete-log-milestone" style="color: #f87171; font-size: 0.95rem;"></strong>
                        </div>
                        <p style="color: #94a3b8; font-size: 0.8rem; margin-top: 0.75rem;">
                            This action cannot be undone. The client timeline entry will be permanently removed.
                        </p>
                    </div>
                    <footer class="engineer-modal-footer">
                        <button type="button" class="engineer-button engineer-button-outline" data-close-delete-modal>Cancel</button>
                        <button type="submit" class="engineer-button" style="background: #ef4444; border: 1px solid #dc2626; color: #fff; font-weight: 600; cursor: pointer;">Confirm Retract Log</button>
                    </footer>
                </form>
            </section>
        </div>

    </div>{# /engineer-operations-page #}

    <script>
    (function () {
        function setupEngineerModals() {
            var page = document.querySelector('.engineer-operations-page');
            if (!page) return;

            // 1. Submit operations log modal
            var logModal = page.querySelector('[data-engineer-modal]');
            var logReqId = logModal ? logModal.querySelector('[data-engineer-request-id]') : null;
            var logVessel = logModal ? logModal.querySelector('[data-engineer-vessel]') : null;
            var logStatus = logModal ? logModal.querySelector('#engineer-status') : null;

            page.querySelectorAll('[data-engineer-open-log]').forEach(function (btn) {
                btn.onclick = function (e) {
                    e.preventDefault();
                    if (!logModal) return;
                    if (logReqId) logReqId.value = btn.dataset.requestId || '';
                    if (logVessel) logVessel.textContent = btn.dataset.vessel || '';
                    if (logStatus) logStatus.value = btn.dataset.status || 'deployed';
                    logModal.classList.add('is-open');
                    logModal.setAttribute('aria-hidden', 'false');
                    document.body.classList.add('engineer-modal-open');
                };
            });

            page.querySelectorAll('[data-engineer-close]').forEach(function (btn) {
                btn.onclick = function (e) {
                    e.preventDefault();
                    if (logModal) {
                        logModal.classList.remove('is-open');
                        logModal.setAttribute('aria-hidden', 'true');
                    }
                    document.body.classList.remove('engineer-modal-open');
                };
            });

            // 2. Edit Own Log Modal
            var editModal = document.getElementById('editOwnUpdateModal');
            var editId = document.getElementById('edit-log-update-id');
            var editVessel = document.getElementById('edit-log-vessel');
            var editMilestone = document.getElementById('edit-log-milestone');
            var editDetails = document.getElementById('edit-log-details');

            page.querySelectorAll('[data-edit-my-log]').forEach(function (btn) {
                btn.onclick = function (e) {
                    e.preventDefault();
                    if (!editModal) return;
                    if (editId) editId.value = btn.dataset.updateId || '';
                    if (editVessel) editVessel.textContent = btn.dataset.vessel || '';
                    if (editMilestone) editMilestone.value = btn.dataset.milestone || '';
                    if (editDetails) editDetails.value = btn.dataset.details || '';
                    editModal.classList.add('is-open');
                    editModal.setAttribute('aria-hidden', 'false');
                    document.body.classList.add('engineer-modal-open');
                };
            });

            page.querySelectorAll('[data-close-edit-modal]').forEach(function (btn) {
                btn.onclick = function (e) {
                    e.preventDefault();
                    if (editModal) {
                        editModal.classList.remove('is-open');
                        editModal.setAttribute('aria-hidden', 'true');
                    }
                    document.body.classList.remove('engineer-modal-open');
                };
            });

            // 3. Retract / Delete Own Log Modal
            var delModal = document.getElementById('deleteOwnUpdateModal');
            var delId = document.getElementById('delete-log-update-id');
            var delVessel = document.getElementById('delete-log-vessel');
            var delMilestone = document.getElementById('delete-log-milestone');

            page.querySelectorAll('[data-delete-my-log]').forEach(function (btn) {
                btn.onclick = function (e) {
                    e.preventDefault();
                    if (!delModal) return;
                    if (delId) delId.value = btn.dataset.updateId || '';
                    if (delVessel) delVessel.textContent = btn.dataset.vessel ? ('Vessel: ' + btn.dataset.vessel) : '';
                    if (delMilestone) delMilestone.textContent = btn.dataset.milestone || '';
                    delModal.classList.add('is-open');
                    delModal.setAttribute('aria-hidden', 'false');
                    document.body.classList.add('engineer-modal-open');
                };
            });

            page.querySelectorAll('[data-close-delete-modal]').forEach(function (btn) {
                btn.onclick = function (e) {
                    e.preventDefault();
                    if (delModal) {
                        delModal.classList.remove('is-open');
                        delModal.setAttribute('aria-hidden', 'true');
                    }
                    document.body.classList.remove('engineer-modal-open');
                };
            });

            // Close on backdrop click
            [logModal, editModal, delModal].forEach(function (m) {
                if (m) {
                    m.onclick = function (e) {
                        if (e.target === m) {
                            m.classList.remove('is-open');
                            m.setAttribute('aria-hidden', 'true');
                            document.body.classList.remove('engineer-modal-open');
                        }
                    };
                }
            });

            // Close alerts
            page.querySelectorAll('[data-engineer-alert-close]').forEach(function (btn) {
                btn.onclick = function () {
                    var alert = btn.closest('.engineer-alert');
                    if (alert) alert.remove();
                };
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupEngineerModals);
        } else {
            setupEngineerModals();
        }
        document.addEventListener('turbo:load', setupEngineerModals);
        document.addEventListener('turbo:render', setupEngineerModals);
    })();
    </script>
{% endblock %}
