<footer class="dashboard-footer">
    <div class="footer-content">
        <a class="footer-brand" href="{{ path('app_home') }}" aria-label="{{ brand }} home">
            <span class="footer-logo" aria-hidden="true">
                {% if logo_path %}
                    <img src="{{ asset(logo_path) }}" width="28" height="28" alt="">
                {% else %}
                    LOGO
                {% endif %}
            </span>
            <span>{{ brand }}</span>
        </a>
        <span class="footer-copyright">&copy; {{ 'now'|date('Y') }} {{ brand }}. All Rights Reserved.</span>
        <a class="footer-back-top" href="#main-content">Back to top <span aria-hidden="true">&uarr;</span></a>
    </div>
</footer>
