<header class="topbar">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <a class="header-brand" href="{{ path('app_home') }}" aria-label="{{ brand }} home">
        <span class="header-logo" aria-hidden="true">
            {% if logo_path %}
                <img src="{{ asset(logo_path) }}" width="40" height="40" alt="">
            {% else %}
                <span class="logo-placeholder">LOGO</span>
            {% endif %}
        </span>
        <span class="header-brand-name">{{ brand }}</span>
    </a>
    {% if account_name|default(false) %}
        <nav class="header-actions" aria-label="Account">
            <span class="header-account">Signed in as <strong>{{ account_name }}</strong></span>
            <a class="header-action-link login-button" href="{{ path('app_dashboard') }}">Dashboard</a>
            <a class="header-action-link register-button" href="{{ path('app_logout') }}">Log out</a>
        </nav>
    {% else %}
        <nav class="header-actions" aria-label="Account">
            <a class="header-action-link login-button" href="{{ path('app_login') }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 5H5v14h5M9 12h11m-4-4 4 4-4 4" /></svg>
                Log In
            </a>
            <a class="header-action-link register-button" href="{{ path('app_contact') }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="7" r="3" /><path d="M3 20v-3a6 6 0 0 1 12 0v3H3m16-13v6m-3-3h6" /></svg>
                Request Service
            </a>
        </nav>
    {% endif %}
</header>
