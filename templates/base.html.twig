<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Apex Marine{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Marine engineering, vessel maintenance, and worldwide operations support from Apex Marine.{% endblock %}">
        <meta name="theme-color" content="#0e2b49">
        <meta name="color-scheme" content="dark">

        <meta property="og:site_name" content="Apex Marine">
        <meta property="og:type" content="website">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('meta_description') }}">

        {# Replace this placeholder favicon with your own icon when ready. #}
        <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">

        {# AssetMapper also loads the CSS imported by assets/app.js. #}
        {% block stylesheets %}{% endblock %}
        {% block head %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% if app.environment == 'dev' and app.request %}
            {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
            {% if frankenphp_hot_reload %}
                <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
                <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
                <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
            {% endif %}
        {% endif %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
