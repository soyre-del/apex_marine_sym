{% extends 'dashboard/index.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/contact.css') }}">
{% endblock %}

{% macro icon(name) %}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {% if name == 'mail' %}
            <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
        {% elseif name == 'building' %}
            <path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16M3 21h18M9 7h1m4 0h1M9 11h1m4 0h1M10 21v-6h4v6"/>
        {% elseif name == 'globe' %}
            <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a16 16 0 0 1 0 18 16 16 0 0 1 0-18Z"/>
        {% elseif name == 'chat' %}
            <path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5Z"/>
        {% elseif name == 'linkedin' %}
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6ZM2 9h4v12H2Z"/><circle cx="4" cy="4" r="2"/>
        {% elseif name == 'facebook' %}
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3Z"/>
        {% elseif name == 'instagram' %}
            <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>
        {% elseif name == 'clock' %}
            <circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 3"/>
        {% elseif name == 'lock' %}
            <rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4M12 14v3"/>
        {% else %}
            <path d="m22 2-7 20-4-9L2 9 22 2ZM11 13 22 2"/>
        {% endif %}
    </svg>
{% endmacro %}

{% macro field_error(name, errors) %}
    {% if errors[name] is defined %}
        <p class="contact-field-error" id="{{ name }}_error">{{ errors[name] }}</p>
    {% endif %}
{% endmacro %}

{% macro input_field(name, label, type, values, errors, required = true, placeholder = '', maxlength = null) %}
    <div class="contact-field">
        <label class="contact-field-label" for="{{ name }}">{{ label }}</label>
        <input class="contact-input" id="{{ name }}" name="{{ name }}" type="{{ type }}" value="{{ values[name] }}"{% if required %} required{% endif %}{% if placeholder %} placeholder="{{ placeholder }}"{% endif %}{% if maxlength %} maxlength="{{ maxlength }}"{% endif %}{% if errors[name] is defined %} aria-invalid="true" aria-describedby="{{ name }}_error"{% endif %}>
        {{ _self.field_error(name, errors) }}
    </div>
{% endmacro %}

{% macro select_field(name, label, choices, values, errors) %}
    <div class="contact-field">
        <label class="contact-field-label" for="{{ name }}">{{ label }}</label>
        <select class="contact-input" id="{{ name }}" name="{{ name }}" required{% if errors[name] is defined %} aria-invalid="true" aria-describedby="{{ name }}_error"{% endif %}>
            <option value="">Select {{ label|lower }}</option>
            {% for value, text in choices %}
                <option value="{{ value }}"{% if values[name] == value %} selected{% endif %}>{{ text }}</option>
            {% endfor %}
        </select>
        {{ _self.field_error(name, errors) }}
    </div>
{% endmacro %}

{% block main_class %}contact-main{% endblock %}

{% block page_content %}
    {% import _self as ui %}
    <div class="contact-page">
        <div class="contact-container">
            <header class="contact-heading-area">
                <p class="contact-eyebrow"><span class="contact-eyebrow-dot" aria-hidden="true"></span>Reach Out</p>
                <h1 class="contact-title">Contact Operations</h1>
                <p class="contact-intro">Whether it's an emergency dispatch or scheduling routine heavy-duty maintenance, our engineering team is ready to deploy.</p>
            </header>

            <div class="contact-columns">
                <aside class="contact-info-card" aria-labelledby="contact-operations-heading">
                    <h2 class="contact-card-title" id="contact-operations-heading">Global Operations</h2>
                    <a class="contact-dispatch-email" href="mailto:{{ contact.email }}">
                        <span class="contact-info-icon">{{ ui.icon('mail') }}</span>
                        <div>
                            <span class="contact-label">Central Dispatch Email</span>
                            <strong class="contact-email">{{ contact.email }}</strong>
                        </div>
                    </a>

                    <div class="contact-hubs">
                        {% for hub in contact.hubs %}
                            <section class="contact-hub" aria-labelledby="contact-hub-{{ loop.index }}">
                                <h3 class="contact-hub-title" id="contact-hub-{{ loop.index }}">
                                    {{ ui.icon(loop.first ? 'building' : 'globe') }}
                                    <span>{{ hub.title }}</span>
                                    {% if hub.badge %}<span class="contact-badge">{{ hub.badge }}</span>{% endif %}
                                </h3>
                                <div class="contact-hub-entries">
                                    {% for entry in hub.entries %}
                                        <div class="contact-hub-entry">
                                            <span class="contact-label">{{ entry.location }}</span>
                                            <a class="contact-phone" href="tel:{{ entry.dial }}">{{ entry.phone }}</a>
                                        </div>
                                    {% endfor %}
                                </div>
                            </section>
                        {% endfor %}
                    </div>

                    <section class="contact-digital" aria-labelledby="contact-digital-heading">
                        <h3 class="contact-label" id="contact-digital-heading">Digital Channels</h3>
                        {% for channel in contact.channels %}
                            <div class="contact-channel">
                                <span class="contact-info-icon">{{ ui.icon(channel.icon) }}</span>
                                <div>
                                    <span class="contact-label">{{ channel.label }}</span>
                                    <strong class="contact-handle">{{ channel.handle }}</strong>
                                </div>
                            </div>
                        {% endfor %}
                    </section>

                    <div class="contact-operational-status">
                        <span class="contact-label">{{ ui.icon('clock') }}Status</span>
                        <p class="contact-online"><span aria-hidden="true"></span>Online &amp; Operating 24/7</p>
                    </div>
                </aside>

                <section class="contact-form-card" aria-labelledby="contact-dispatch-heading">
                    <div class="contact-form-heading">
                        {{ ui.icon('send') }}
                        <h2 class="contact-form-title" id="contact-dispatch-heading">Request Dispatch</h2>
                    </div>

                    {% for message in app.flashes('dispatch_success') %}
                        <div class="contact-alert contact-alert-success" role="status">{{ message }}</div>
                    {% endfor %}
                    {% if error_status %}
                        <div class="contact-alert contact-alert-error" role="alert">
                            <p>{{ error_status }}</p>
                            {% if errors %}
                                <ul>
                                    {% for field, message in errors %}
                                        <li><a href="#{{ field }}">{{ message }}</a></li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    {% endif %}

                    <form class="contact-form" action="{{ path('app_contact') }}" method="post" enctype="multipart/form-data" data-turbo="false" id="dispatchRequestForm" data-can-submit="{{ can_submit ? '1' : '0' }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('dispatch_request') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('dispatch_request') }}">
                        <div class="contact-form-grid">
                            {{ ui.input_field('vessel_name', 'Vessel Name', 'text', values, errors, true, 'e.g., MV Pacific Horizon', 255) }}

                            <div class="contact-field">
                                <label class="contact-field-label" for="imo_number">IMO Number</label>
                                <input class="contact-input" id="imo_number" name="imo_number" type="text" value="{{ values.imo_number }}" required placeholder="e.g., 9876543" maxlength="7"{% if errors.imo_number is defined %} aria-invalid="true" aria-describedby="imo_number_error"{% endif %}>
                                <div id="imo-feedback" style="display: none; margin-top: 6px; font-size: 0.78rem;"></div>
                                {{ ui.field_error('imo_number', errors) }}
                            </div>

                            <div class="contact-field">
                                <label class="contact-field-label" for="vessel_type">Vessel Type</label>
                                <select class="contact-input" id="vessel_type" name="vessel_type" required{% if errors.vessel_type is defined %} aria-invalid="true" aria-describedby="vessel_type_error"{% endif %}>
                                    <option value="">Select vessel type</option>
                                    {% for value, text in contact.vessel_types %}
                                        <option value="{{ value }}"{% if values.vessel_type == value %} selected{% endif %}>{{ text }}</option>
                                    {% endfor %}
                                </select>
                                {{ ui.field_error('vessel_type', errors) }}
                                <div id="vessel-class-preview" style="display: none; margin-top: 8px; padding: 8px 12px; border-radius: 6px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.8rem; color: #6ee7b7;"></div>
                            </div>

                            {{ ui.input_field('company', 'Company / Operator (Optional)', 'text', values, errors, false, 'e.g., Maersk Marine Lines', 255) }}
                            {{ ui.input_field('contact_person', 'Contact Person', 'text', values, errors, true, 'e.g., Chief Engineer James Thorne', 255) }}

                            <div class="contact-field">
                                <label class="contact-field-label" for="phone_number">Contact Phone</label>
                                <div class="contact-phone-group">
                                    <select class="contact-input" id="country_code" name="country_code" aria-label="Country code" required{% if errors.country_code is defined %} aria-invalid="true" aria-describedby="country_code_error"{% endif %}>
                                        {% for code, label in contact.country_codes %}
                                            <option value="{{ code }}"{% if values.country_code == code %} selected{% endif %}>{{ label }}</option>
                                        {% endfor %}
                                    </select>
                                    <input class="contact-input" id="phone_number" name="phone_number" type="tel" value="{{ values.phone_number }}" autocomplete="tel-national" placeholder="917 000 1234" maxlength="30" required{% if errors.phone_number is defined %} aria-invalid="true" aria-describedby="phone_number_error"{% endif %}>
                                </div>
                                {{ ui.field_error('country_code', errors) }}
                                {{ ui.field_error('phone_number', errors) }}
                            </div>

                            {{ ui.input_field('eta_date', 'ETA / Service Date', 'date', values, errors) }}

                            <div class="contact-field">
                                <label class="contact-urgent" for="urgent">
                                    <input type="checkbox" id="urgent" name="urgent" value="1"{% if values.urgent %} checked{% endif %}>
                                    <span>Urgent Request</span>
                                </label>
                            </div>

                            <div class="contact-field">
                                <label class="contact-field-label" for="location">Service Location</label>
                                <select class="contact-input" id="location" name="location" required{% if errors.location is defined %} aria-invalid="true" aria-describedby="location_error"{% endif %}>
                                    <option value="">Select service location</option>
                                    {% for group, locations in contact.locations %}
                                        <optgroup label="{{ group }}">
                                            {% for id, label in locations %}
                                                <option value="{{ id }}"{% if values.location == id %} selected{% endif %}>{{ label }} ({{ group|split(' ')|first }})</option>
                                            {% endfor %}
                                        </optgroup>
                                    {% endfor %}
                                </select>
                                {{ ui.field_error('location', errors) }}
                                <div id="location-hub-preview" style="display: none; margin-top: 8px; padding: 10px 14px; border-radius: 8px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); font-size: 0.82rem; color: #bae6fd;"></div>
                            </div>

                            <div class="contact-field">
                                <label class="contact-field-label" for="service_type">Service Type</label>
                                <select class="contact-input" id="service_type" name="service_type" required{% if errors.service_type is defined %} aria-invalid="true" aria-describedby="service_type_error"{% endif %}>
                                    <option value="">Select service type</option>
                                    {% for value, text in contact.service_types %}
                                        <option value="{{ value }}"{% if values.service_type == value %} selected{% endif %}>{{ text }}</option>
                                    {% endfor %}
                                </select>
                                {{ ui.field_error('service_type', errors) }}
                                <div id="service-discipline-preview" style="display: none; margin-top: 8px; padding: 10px 14px; border-radius: 8px; background: rgba(11, 165, 223, 0.12); border: 1px solid rgba(11, 165, 223, 0.35); font-size: 0.82rem; color: #7dd3fc;"></div>
                            </div>
                        </div>

                        <div class="contact-form-row contact-field">
                            <label class="contact-field-label" for="attachment">Attachment (Optional)</label>
                            <input class="contact-input" id="attachment" name="attachment" type="file" accept="image/png,image/jpeg,application/pdf" aria-describedby="attachment_hint{% if errors.attachment is defined %} attachment_error{% endif %}"{% if errors.attachment is defined %} aria-invalid="true"{% endif %}>
                            <p class="contact-file-hint" id="attachment_hint">JPG, PNG, or PDF. Maximum size: 5 MB. Select the file again if you need to resubmit.</p>
                            {{ ui.field_error('attachment', errors) }}
                        </div>

                        <div class="contact-form-row contact-field">
                            <label class="contact-field-label" for="description">
                                Request Details
                                <span id="char-counter" style="float: right; font-size: 0.75rem; color: #a3b6c8; font-weight: normal;">0 / 10,000</span>
                            </label>
                            <textarea class="contact-input" id="description" name="description" rows="4" maxlength="10000" placeholder="Provide details about the required maintenance or repair..." required{% if errors.description is defined %} aria-invalid="true" aria-describedby="description_error"{% endif %}>{{ values.description }}</textarea>
                            {{ ui.field_error('description', errors) }}
                        </div>

                        {# Dynamic Form Manipulation Notice #}
                        <div id="urgent-notice" style="display: none; padding: 10px 14px; border-radius: 6px; margin-bottom: 1rem; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.35); color: #fbbf24; font-size: 0.82rem;">
                            <strong>Urgent Request:</strong> Priority dispatch requested.
                        </div>

                        <div id="file-info" style="display: none; padding: 8px 12px; border-radius: 6px; margin-bottom: 1rem; background: rgba(11, 165, 223, 0.12); border: 1px solid rgba(11, 165, 223, 0.3); color: #0ba5df; font-size: 0.82rem;"></div>

                        {# User authorization / clearance status banner #}
                        <div class="contact-dispatch-mode" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 1.25rem; padding: 10px 14px; border-radius: 8px; background: rgba(14, 43, 73, 0.7); border: 1px solid {{ can_submit ? 'rgba(16, 185, 129, 0.35)' : 'rgba(245, 158, 11, 0.45)' }};">
                            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                {% if can_submit %}
                                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
                                    <span style="font-size: 0.82rem; color: #f0f5ff;">Authorized Client: <strong style="color: #38bdf8;">{{ client_name }}</strong></span>
                                {% elseif is_logged_in %}
                                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #f59e0b;"></span>
                                    <span style="font-size: 0.82rem; color: #f0f5ff;">Dispatch submission is restricted to <strong>Client</strong> accounts. <a href="{{ path('app_logout') }}" style="color: #38bdf8; text-decoration: underline;">Switch to a Client account</a> to send a request.</span>
                                {% else %}
                                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #f59e0b;"></span>
                                    <span style="font-size: 0.82rem; color: #f0f5ff;">Client Account Required &mdash; Please <a href="{{ path('app_login') }}" style="color: #38bdf8; font-weight: 600; text-decoration: underline;">Log In</a> or <a href="{{ path('app_register') }}" style="color: #38bdf8; font-weight: 600; text-decoration: underline;">Register</a> to unlock dispatch submission.</span>
                                {% endif %}
                            </div>
                            <span style="font-size: 0.72rem; color: #38bdf8; font-weight: 600;">Apex Marine 24/7</span>
                        </div>

                        {% if can_submit %}
                            <button class="contact-submit" type="submit" style="cursor: pointer;">{{ ui.icon('send') }} Submit Dispatch Request</button>
                        {% else %}
                            <button class="contact-submit is-locked" type="button" disabled aria-disabled="true" style="opacity: 0.65; cursor: not-allowed; background: rgba(30, 58, 86, 0.9); color: #9ab0c6; border: 1px solid rgba(163, 182, 200, 0.3); box-shadow: none;">
                                {{ ui.icon('lock') }} Locked &mdash; Log In as Client to Submit Dispatch Request
                            </button>
                        {% endif %}
                    </form>
                </section>
            </div>
        </div>
    </div>

    <script>
    (function () {
        function initContactForm() {
            var urgentCheckbox     = document.getElementById('urgent');
            var urgentNotice       = document.getElementById('urgent-notice');
            var formCard           = document.querySelector('.contact-form-card');
            var descTextarea       = document.getElementById('description');
            var charCounter        = document.getElementById('char-counter');
            var fileInput          = document.getElementById('attachment');
            var fileInfo           = document.getElementById('file-info');
            var serviceTypeSelect  = document.getElementById('service_type');
            var servicePreview     = document.getElementById('service-discipline-preview');
            var locationSelect     = document.getElementById('location');
            var locationPreview    = document.getElementById('location-hub-preview');
            var vesselTypeSelect   = document.getElementById('vessel_type');
            var vesselPreview      = document.getElementById('vessel-class-preview');
            var countryCodeSelect  = document.getElementById('country_code');
            var etaDateInput       = document.getElementById('eta_date');
            var imoInput           = document.getElementById('imo_number');
            var imoFeedback        = document.getElementById('imo-feedback');

            // Set minimum ETA date to local today and prefill if empty
            if (etaDateInput) {
                var now = new Date();
                var y = now.getFullYear();
                var m = String(now.getMonth() + 1).padStart(2, '0');
                var d = String(now.getDate()).padStart(2, '0');
                var localToday = y + '-' + m + '-' + d;
                etaDateInput.setAttribute('min', localToday);
                if (!etaDateInput.value) {
                    etaDateInput.value = localToday;
                }
            }

            // Auto-filter non-digits on IMO input
            if (imoInput) {
                imoInput.addEventListener('input', function() {
                    var sanitized = this.value.replace(/\D/g, '').slice(0, 7);
                    if (this.value !== sanitized) {
                        this.value = sanitized;
                    }
                });
            }

            // Intercept form submit for smooth UX and robust validation
            var form = document.getElementById('dispatchRequestForm');
            var submitBtn = form ? form.querySelector('button[type="submit"]') : null;
            if (form) {
                form.addEventListener('submit', function (e) {
                    if (form.getAttribute('data-can-submit') !== '1' || !submitBtn) {
                        e.preventDefault();
                        return false;
                    }
                    if (!form.checkValidity()) {
                        e.preventDefault();
                        var firstInvalid = form.querySelector(':invalid');
                        if (firstInvalid) {
                            firstInvalid.focus();
                            firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            firstInvalid.style.outline = '2px solid #ef4444';
                            firstInvalid.style.borderColor = '#ef4444';
                            setTimeout(function() {
                                firstInvalid.style.outline = '';
                                firstInvalid.style.borderColor = '';
                            }, 3000);
                        }
                        return false;
                    }
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = 'Submitting...';
                    submitBtn.style.opacity = '0.85';
                    submitBtn.style.cursor = 'wait';
                });
            }

            // 1. Dynamic Urgent State Manipulation
            function updateUrgentState() {
                if (!urgentCheckbox) return;
                var isUrgent = urgentCheckbox.checked;
                if (urgentNotice) urgentNotice.style.display = isUrgent ? 'block' : 'none';
                if (formCard) {
                    if (isUrgent) {
                        formCard.style.boxShadow = '0 0 0 2px rgba(245, 158, 11, .6), 0 16px 48px rgba(0, 0, 0, .5)';
                    } else {
                        formCard.style.boxShadow = '';
                    }
                }
                if (isUrgent && etaDateInput && !etaDateInput.value) {
                    etaDateInput.value = new Date().toISOString().split('T')[0];
                }
            }
            if (urgentCheckbox) {
                urgentCheckbox.addEventListener('change', updateUrgentState);
                updateUrgentState();
            }

            // 2. Dynamic Service Type State
            var serviceDisciplineMap = {
                'Propulsion & Machinery': 'Marine Propulsion Specialist',
                'Electrical & Automation': 'Electrical & Automation Engineer',
                'Hydraulics & Deck Gear': 'Hydraulics Specialist',
                'Hull & Steel Fabrication': 'Hull & Steel Fabricator',
                'Preventative Maintenance': 'Maintenance Surveyor',
                'General Consultation': 'Technical Superintendent'
            };

            function updateServiceTypeState() {
                if (!serviceTypeSelect || !servicePreview) return;
                var val = serviceTypeSelect.value;
                var role = serviceDisciplineMap[val];
                if (role) {
                    servicePreview.innerHTML = 'Assigned: <strong>' + role + '</strong>';
                    servicePreview.style.display = 'block';
                } else {
                    servicePreview.style.display = 'none';
                }
            }
            if (serviceTypeSelect) {
                serviceTypeSelect.addEventListener('change', updateServiceTypeState);
                updateServiceTypeState();
            }

            // 3. Dynamic Location State
            var locationHubMap = {
                '1': { name: 'Singapore Station', code: '+65' },
                '2': { name: 'Shanghai Station', code: '+86' },
                '3': { name: 'Rotterdam Station', code: '+31' },
                '4': { name: 'Dubai Station', code: '+971' },
                '5': { name: 'Cape Town Station', code: '+27' },
                '6': { name: 'Houston Station', code: '+1' },
                '7': { name: 'Panama Station', code: '+507' }
            };

            function updateLocationState() {
                if (!locationSelect || !locationPreview) return;
                var val = locationSelect.value;
                var data = locationHubMap[val];
                if (data) {
                    locationPreview.innerHTML = 'Station: <strong>' + data.name + '</strong>';
                    locationPreview.style.display = 'block';

                    var phoneInput = document.getElementById('phone_number');
                    if (countryCodeSelect && (!phoneInput || !phoneInput.value)) {
                        countryCodeSelect.value = data.code;
                    }
                } else {
                    locationPreview.style.display = 'none';
                }
            }
            if (locationSelect) {
                locationSelect.addEventListener('change', updateLocationState);
                updateLocationState();
            }

            // 4. Dynamic Vessel Type State
            function updateVesselTypeState() {
                if (!vesselTypeSelect || !vesselPreview) return;
                var val = vesselTypeSelect.value;
                if (val) {
                    vesselPreview.textContent = 'Selected: ' + val;
                    vesselPreview.style.display = 'block';
                } else {
                    vesselPreview.style.display = 'none';
                }
            }
            if (vesselTypeSelect) {
                vesselTypeSelect.addEventListener('change', updateVesselTypeState);
                updateVesselTypeState();
            }

            // 5. Dynamic IMO Number Live Format Validation
            function updateImoValidation() {
                if (!imoInput || !imoFeedback) return;
                var val = imoInput.value.trim();
                if (val.length === 0) {
                    imoFeedback.style.display = 'none';
                    return;
                }
                if (/^\d{7}$/.test(val)) {
                    imoFeedback.style.display = 'block';
                    imoFeedback.style.color = '#34d399';
                    imoFeedback.textContent = 'Valid IMO (7 digits)';
                } else {
                    imoFeedback.style.display = 'block';
                    imoFeedback.style.color = '#f59e0b';
                    imoFeedback.textContent = '7 digits required (' + val.length + '/7)';
                }
            }
            if (imoInput) {
                imoInput.addEventListener('input', updateImoValidation);
                updateImoValidation();
            }

            // 6. Dynamic Character Counter
            function updateCharCount() {
                if (!descTextarea || !charCounter) return;
                var len = descTextarea.value.length;
                charCounter.textContent = len.toLocaleString() + ' / 10,000';
                if (len > 9500) {
                    charCounter.style.color = '#ef4444';
                } else if (len > 8000) {
                    charCounter.style.color = '#f59e0b';
                } else {
                    charCounter.style.color = '#a3b6c8';
                }
            }
            if (descTextarea) {
                descTextarea.addEventListener('input', updateCharCount);
                updateCharCount();
            }

            // 7. Dynamic File Upload Info
            if (fileInput && fileInfo) {
                fileInput.addEventListener('change', function () {
                    if (fileInput.files && fileInput.files[0]) {
                        var file = fileInput.files[0];
                        if (file.size > 5 * 1024 * 1024) {
                            fileInfo.innerHTML = 'File exceeds 5 MB limit.';
                            fileInfo.style.borderColor = '#ef4444';
                            fileInfo.style.color = '#ef4444';
                            fileInfo.style.background = 'rgba(239, 68, 68, 0.15)';
                        } else {
                            fileInfo.innerHTML = 'File: ' + file.name;
                            fileInfo.style.borderColor = 'rgba(11, 165, 223, 0.4)';
                            fileInfo.style.color = '#0ba5df';
                            fileInfo.style.background = 'rgba(11, 165, 223, 0.12)';
                        }
                        fileInfo.style.display = 'block';
                    } else {
                        fileInfo.style.display = 'none';
                    }
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initContactForm);
        } else {
            initContactForm();
        }
        document.addEventListener('turbo:load', initContactForm);
        document.addEventListener('turbo:render', initContactForm);
    })();
    </script>
{% endblock %}
