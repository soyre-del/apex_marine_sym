{% extends 'base.html.twig' %}

{% block title %}Log In | Apex Marine{% endblock %}
{% block body_class %}auth-page{% endblock %}
{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
{% endblock %}

{% block body %}
    <main class="auth-shell container d-flex flex-column align-items-center justify-content-center py-5">

        <a class="auth-brand mb-4" href="{{ path('app_home') }}">
            <img src="{{ asset('images/Logo.png') }}" alt="Apex Marine">
            <span>Apex&nbsp;<strong>Marine</strong></span>
        </a>

        <section class="auth-card w-100" aria-labelledby="login-heading">
            <div class="auth-content">

                <div class="auth-heading">
                    <h1 id="login-heading">Welcome back</h1>
                    <p>Sign in to your account to continue.</p>
                </div>

                {% if error %}
                    <div class="auth-alert" role="alert">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="vertical-align:-.15em;margin-right:.4rem"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}" class="auth-form" novalidate>

                    <div class="mb-3">
                        <label class="form-label" for="login-email">Email address</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-9.1 6.1a2 2 0 0 1-2.2 0L2 7"/></svg>
                            <input class="form-control" id="login-email" type="email" name="email"
                                   value="{{ last_username }}" autocomplete="email"
                                   placeholder="you@example.com" required autofocus>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="login-password">Password</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            <input class="form-control" id="login-password" type="password" name="password"
                                   autocomplete="current-password"
                                   placeholder="Enter your password" required>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="form-check auth-remember mb-4">
                        <input class="form-check-input" id="remember-me" type="checkbox" name="_remember_me">
                        <label class="form-check-label" for="remember-me">Keep me signed in</label>
                    </div>

                    <button class="btn w-100 auth-submit" type="submit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="margin-right:.4rem"><path d="M15 3h6v18h-6M10 17l5-5-5-5M15 12H3"/></svg>
                        Log in
                    </button>
                </form>

                <p class="auth-switch">
                    Don't have an account?
                    <a href="{{ path('app_register') }}">Create an account</a>
                </p>

            </div>
        </section>

        <a class="auth-home-link mt-4" href="{{ path('app_home') }}">
            ← Back to Apex Marine
        </a>

    </main>
{% endblock %}
