{% extends 'base.html.twig' %}

{% block title %}Log In | Apex Marine{% endblock %}
{% block body_class %}app-layout{% endblock %}

{% block body %}
    <main class="login-page">
        <section class="login-card" aria-labelledby="login-heading">
            <a class="login-brand" href="{{ path('app_home') }}">Apex Marine</a>
            <p class="login-eyebrow">Operations portal</p>
            <h1 id="login-heading">Welcome back</h1>
            <p class="login-intro">Sign in to continue to your workspace.</p>

            {% if error %}
                <div class="login-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="login-form">
                <label for="login-email">Email address</label>
                <input id="login-email" type="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus>

                <label for="login-password">Password</label>
                <input id="login-password" type="password" name="password" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <label class="login-remember">
                    <input type="checkbox" name="_remember_me">
                    <span>Keep me signed in</span>
                </label>

                <button type="submit">Log in</button>
            </form>

            <a class="login-back-link" href="{{ path('app_home') }}">Back to Apex Marine</a>
        </section>
    </main>
{% endblock %}
