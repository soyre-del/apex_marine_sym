{% extends 'base.html.twig' %}

{% block title %}Log In | Apex Marine{% endblock %}
{% block body_class %}auth-page{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
    <style>
        body.auth-page {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            width: 100% !important;
            min-height: 100vh !important;
            min-height: 100dvh !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #0e2b49 !important;
        }
        main.auth-shell {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            width: 100% !important;
            max-width: 100% !important;
            min-height: 100vh !important;
            min-height: 100dvh !important;
            margin: 0 auto !important;
            padding: 3rem 1.25rem !important;
            box-sizing: border-box !important;
            background: radial-gradient(ellipse 70% 50% at 50% -10%, rgba(11, 165, 223, .15), transparent), #0e2b49 !important;
        }
        .auth-brand {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: .65rem !important;
            margin: 0 auto 1.5rem !important;
        }
        .auth-card {
            width: 100% !important;
            max-width: 460px !important;
            margin-left: auto !important;
            margin-right: auto !important;
            background: #0f2a44 !important;
            border: 1px solid #23415d !important;
            border-radius: 1rem !important;
        }
        .auth-heading {
            text-align: center;
            margin-bottom: 1.75rem;
        }
        .auth-form .mb-3 { margin-bottom: 1.15rem; }
        .auth-form .mb-4 { margin-bottom: 1.5rem; }
        .auth-form .form-label {
            display: block;
            margin-bottom: .45rem;
        }
        .auth-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }
        .auth-form .form-control {
            display: block;
            width: 100%;
            box-sizing: border-box;
            padding-left: 2.5rem;
        }
        .auth-form .auth-password-input {
            padding-right: 5rem !important;
        }
        .auth-password-toggle {
            position: absolute;
            top: 50%;
            right: .55rem;
            transform: translateY(-50%);
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            padding: .3rem .58rem;
            border: 1px solid rgba(11, 165, 223, .28);
            border-radius: .4rem;
            background: rgba(11, 165, 223, .1);
            color: #8fd8f8;
            font-family: inherit;
            font-size: .74rem;
            font-weight: 600;
            letter-spacing: .02em;
            cursor: pointer;
            z-index: 2;
            transition: background-color .15s ease, border-color .15s ease, color .15s ease;
        }
        .auth-password-toggle:hover {
            background: rgba(11, 165, 223, .22);
            border-color: rgba(11, 165, 223, .55);
            color: #ffffff;
        }
        .auth-form .form-check {
            display: flex;
            align-items: center;
            gap: .55rem;
        }
        .auth-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            cursor: pointer;
        }
        .auth-home-link {
            display: inline-block;
            margin-top: 1.5rem;
            text-align: center;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="auth-shell container d-flex flex-column align-items-center justify-content-center py-5">

        <a class="auth-brand mb-4" href="{{ path('app_home') }}">
            <img src="{{ asset('images/Logo.png') }}" alt="Apex Marine">
            <span>Apex&nbsp;<strong>Marine</strong></span>
        </a>

        <section class="auth-card w-100" aria-labelledby="login-heading">
            <div class="auth-content">

                <div class="auth-heading">
                    <h1 id="login-heading">Welcome back</h1>
                    <p>Sign in to your account to continue.</p>
                </div>

                {% if error %}
                    <div class="auth-alert" role="alert">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="vertical-align:-.15em;margin-right:.4rem"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}" class="auth-form" novalidate>

                    <div class="mb-3">
                        <label class="form-label" for="login-email">Email address</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-9.1 6.1a2 2 0 0 1-2.2 0L2 7"/></svg>
                            <input class="form-control" id="login-email" type="email" name="email"
                                   value="{{ last_username }}" autocomplete="email"
                                   placeholder="you@example.com" required autofocus>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="login-password">Password</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            <input class="form-control auth-password-input" id="login-password" type="password" name="password"
                                   autocomplete="current-password"
                                   placeholder="Enter your password" required>
                            <button type="button" class="auth-password-toggle" data-password-toggle="login-password" aria-label="Show password" aria-pressed="false">
                                <svg class="icon-eye" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                <svg class="icon-eye-off" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                                <span class="auth-password-toggle-text">Show</span>
                            </button>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="form-check auth-remember mb-4">
                        <input class="form-check-input" id="remember-me" type="checkbox" name="_remember_me">
                        <label class="form-check-label" for="remember-me">Keep me signed in</label>
                    </div>

                    <button class="btn w-100 auth-submit" type="submit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="margin-right:.4rem"><path d="M15 3h6v18h-6M10 17l5-5-5-5M15 12H3"/></svg>
                        Log in
                    </button>
                </form>

                <p class="auth-switch">
                    Don't have an account?
                    <a href="{{ path('app_register') }}">Create an account</a>
                </p>

            </div>
        </section>

        <a class="auth-home-link mt-4" href="{{ path('app_home') }}">
            ← Back to Apex Marine
        </a>

    </main>

    <script>
        (function () {
            document.querySelectorAll('[data-password-toggle]').forEach(function (btn) {
                if (btn.dataset.bound === '1') return;
                btn.dataset.bound = '1';
                btn.addEventListener('click', function () {
                    var wrap = btn.closest('.auth-input-wrap');
                    var input = wrap ? wrap.querySelector('input') : document.getElementById(btn.getAttribute('data-password-toggle'));
                    if (!input) return;
                    var isHidden = input.type === 'password';
                    input.type = isHidden ? 'text' : 'password';
                    btn.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
                    btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
                    var label = btn.querySelector('.auth-password-toggle-text');
                    if (label) label.textContent = isHidden ? 'Hide' : 'Show';
                    var eye = btn.querySelector('.icon-eye');
                    var eyeOff = btn.querySelector('.icon-eye-off');
                    if (eye) eye.hidden = isHidden;
                    if (eyeOff) eyeOff.hidden = !isHidden;
                });
            });
        })();
    </script>
{% endblock %}
