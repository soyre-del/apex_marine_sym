{% extends 'base.html.twig' %}

{% block title %}Create Account | Apex Marine{% endblock %}
{% block body_class %}auth-page{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
    <style>
        body.auth-page {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            width: 100% !important;
            min-height: 100vh !important;
            min-height: 100dvh !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #0e2b49 !important;
        }
        main.auth-shell {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            width: 100% !important;
            max-width: 100% !important;
            min-height: 100vh !important;
            min-height: 100dvh !important;
            margin: 0 auto !important;
            padding: 3rem 1.25rem !important;
            box-sizing: border-box !important;
            background: radial-gradient(ellipse 70% 50% at 50% -10%, rgba(11, 165, 223, .15), transparent), #0e2b49 !important;
        }
        .auth-brand {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: .65rem !important;
            margin: 0 auto 1.5rem !important;
        }
        .auth-card {
            width: 100% !important;
            max-width: 460px !important;
            margin-left: auto !important;
            margin-right: auto !important;
            background: #0f2a44 !important;
            border: 1px solid #23415d !important;
            border-radius: 1rem !important;
        }
        .auth-heading {
            text-align: center;
            margin-bottom: 1.75rem;
        }
        .auth-form .mb-3 { margin-bottom: 1.15rem; }
        .auth-form .mb-4 { margin-bottom: 1.5rem; }
        .auth-form .form-label {
            display: block;
            margin-bottom: .45rem;
        }
        .auth-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }
        .auth-form .form-control {
            display: block;
            width: 100%;
            box-sizing: border-box;
            padding-left: 2.5rem;
        }
        .auth-form .auth-password-input {
            padding-right: 5rem !important;
        }
        .auth-password-toggle {
            position: absolute;
            top: 50%;
            right: .55rem;
            transform: translateY(-50%);
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            padding: .3rem .58rem;
            border: 1px solid rgba(11, 165, 223, .28);
            border-radius: .4rem;
            background: rgba(11, 165, 223, .1);
            color: #8fd8f8;
            font-family: inherit;
            font-size: .74rem;
            font-weight: 600;
            letter-spacing: .02em;
            cursor: pointer;
            z-index: 2;
            transition: background-color .15s ease, border-color .15s ease, color .15s ease;
        }
        .auth-password-toggle:hover {
            background: rgba(11, 165, 223, .22);
            border-color: rgba(11, 165, 223, .55);
            color: #ffffff;
        }
        .auth-form .form-check {
            display: flex;
            align-items: center;
            gap: .55rem;
        }
        .auth-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            cursor: pointer;
        }
        .auth-home-link {
            display: inline-block;
            margin-top: 1.5rem;
            text-align: center;
        }
        .auth-field-hint {
            margin-top: .38rem;
            color: #8da2b5;
            font-size: .74rem;
            line-height: 1.45;
        }
        .auth-security-checklist {
            margin: .5rem 0 0;
            padding: .65rem .8rem;
            border: 1px solid rgba(11, 165, 223, .22);
            border-radius: .5rem;
            background: rgba(8, 28, 45, .65);
            list-style: none;
            display: grid;
            gap: .3rem;
        }
        .auth-security-checklist li {
            display: flex;
            align-items: center;
            gap: .45rem;
            color: #8da2b5;
            font-size: .74rem;
            line-height: 1.35;
            transition: color .15s ease;
        }
        .auth-security-checklist li::before {
            content: '';
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: rgba(141, 162, 181, .45);
            flex-shrink: 0;
            transition: background-color .15s ease;
        }
        .auth-security-checklist li.is-valid {
            color: #34d399;
        }
        .auth-security-checklist li.is-valid::before {
            background: #10b981;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="auth-shell container d-flex flex-column align-items-center justify-content-center py-5">

        <a class="auth-brand mb-4" href="{{ path('app_home') }}">
            <img src="{{ asset('images/Logo.png') }}" alt="Apex Marine">
            <span>Apex&nbsp;<strong>Marine</strong></span>
        </a>

        <section class="auth-card w-100" aria-labelledby="registration-heading">
            <div class="auth-content">

                <div class="auth-heading">
                    <h1 id="registration-heading">Create your account</h1>
                    <p>Register to get started with Apex Marine.</p>
                </div>

                {% if not registrationForm.vars.valid %}
                    <div class="auth-alert" role="alert">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="vertical-align:-.15em;margin-right:.4rem"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        {{ form_errors(registrationForm) }}
                    </div>
                {% endif %}

                {{ form_start(registrationForm, {attr: {class: 'registration-form auth-form', novalidate: 'novalidate'}}) }}

                    <div class="mb-3">
                        <label class="form-label" for="{{ registrationForm.username.vars.id }}">Username <span style="color: #f87171;" aria-hidden="true">*</span></label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                            {{ form_widget(registrationForm.username, {
                                attr: {class: 'form-control', placeholder: 'Choose a username (e.g. juan_cruz)', required: 'required'}
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.username) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="{{ registrationForm.firstName.vars.id }}">First name <span style="color: #f87171;" aria-hidden="true">*</span></label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                            {{ form_widget(registrationForm.firstName, {
                                attr: {class: 'form-control', placeholder: 'Enter your first name', required: 'required', 'data-capitalize-name': ''}
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.firstName) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="{{ registrationForm.middleName.vars.id }}">Middle name <span style="font-weight: 400; color: #8da2b5; font-size: 0.78rem;">(Optional)</span></label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                            {{ form_widget(registrationForm.middleName, {
                                attr: {class: 'form-control', placeholder: 'Enter your middle name (optional)', 'data-capitalize-name': ''}
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.middleName) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="{{ registrationForm.surname.vars.id }}">Surname <span style="color: #f87171;" aria-hidden="true">*</span></label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                            {{ form_widget(registrationForm.surname, {
                                attr: {class: 'form-control', placeholder: 'Enter your surname', required: 'required', 'data-capitalize-name': ''}
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.surname) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="{{ registrationForm.email.vars.id }}">Email address</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-9.1 6.1a2 2 0 0 1-2.2 0L2 7"/></svg>
                            {{ form_widget(registrationForm.email, {
                                attr: {class: 'form-control', placeholder: 'name@company.com'}
                            }) }}
                        </div>
                        <div class="auth-field-hint">Use a valid corporate or personal email domain (e.g. name@company.com). Temporary email domains are blocked.</div>
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="{{ registrationForm.plainPassword.vars.id }}">Password</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            {{ form_widget(registrationForm.plainPassword, {
                                attr: {class: 'form-control auth-password-input', placeholder: 'Min. 8 chars, upper, lower, number, symbol'}
                            }) }}
                            <button type="button" class="auth-password-toggle" data-password-toggle="{{ registrationForm.plainPassword.vars.id }}" aria-label="Show password" aria-pressed="false">
                                <svg class="icon-eye" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                <svg class="icon-eye-off" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                                <span class="auth-password-toggle-text">Show</span>
                            </button>
                        </div>
                        <ul class="auth-security-checklist" id="password-checklist" aria-label="Password security requirements">
                            <li data-rule="length">At least 8 characters (no spaces)</li>
                            <li data-rule="upper">At least one uppercase letter (A-Z)</li>
                            <li data-rule="lower">At least one lowercase letter (a-z)</li>
                            <li data-rule="digit">At least one number (0-9)</li>
                            <li data-rule="special">At least one special character (! @ # $ % ^ &amp; *)</li>
                        </ul>
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    <div class="form-check mb-4">
                        {{ form_widget(registrationForm.agreeTerms, {attr: {class: 'form-check-input'}}) }}
                        <label class="form-check-label" for="{{ registrationForm.agreeTerms.vars.id }}">
                            I agree to the terms &amp; conditions
                        </label>
                    </div>
                    {{ form_errors(registrationForm.agreeTerms) }}

                    <button class="btn w-100 auth-submit" type="submit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="margin-right:.4rem"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                        Create account
                    </button>

                {{ form_end(registrationForm) }}

                <p class="auth-switch">
                    Already have an account?
                    <a href="{{ path('app_login') }}">Log in</a>
                </p>

            </div>
        </section>

        <a class="auth-home-link mt-4" href="{{ path('app_home') }}">
            ← Back to Apex Marine
        </a>

    </main>

    <script>
        (function () {
            document.querySelectorAll('[data-password-toggle]').forEach(function (btn) {
                if (btn.dataset.bound === '1') return;
                btn.dataset.bound = '1';
                btn.addEventListener('click', function () {
                    var wrap = btn.closest('.auth-input-wrap');
                    var input = wrap ? wrap.querySelector('input') : document.getElementById(btn.getAttribute('data-password-toggle'));
                    if (!input) return;
                    var isHidden = input.type === 'password';
                    input.type = isHidden ? 'text' : 'password';
                    btn.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
                    btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
                    var label = btn.querySelector('.auth-password-toggle-text');
                    if (label) label.textContent = isHidden ? 'Hide' : 'Show';
                    var eye = btn.querySelector('.icon-eye');
                    var eyeOff = btn.querySelector('.icon-eye-off');
                    if (eye) eye.hidden = isHidden;
                    if (eyeOff) eyeOff.hidden = !isHidden;
                });
            });

            var capitalizeName = function (value) {
                return value.replace(/(^|[\s'-])(\p{Ll})/gu, function (match, sep, letter) {
                    return sep + letter.toLocaleUpperCase();
                });
            };
            document.querySelectorAll('[data-capitalize-name]').forEach(function (field) {
                field.addEventListener('input', function () {
                    var start = field.selectionStart;
                    var end = field.selectionEnd;
                    var formatted = capitalizeName(field.value);
                    if (formatted !== field.value) {
                        field.value = formatted;
                        if (start !== null) field.setSelectionRange(start, end);
                    }
                });
                field.addEventListener('blur', function () {
                    field.value = capitalizeName(field.value.replace(/\s+/g, ' ').trim());
                });
            });

            var pwdInput = document.getElementById('{{ registrationForm.plainPassword.vars.id }}');
            var checklist = document.getElementById('password-checklist');
            if (pwdInput && checklist) {
                var updateChecklist = function () {
                    var val = pwdInput.value || '';
                    var rules = {
                        length: val.length >= 8 && val.length <= 128 && !/\s/.test(val),
                        upper: /[A-Z]/.test(val),
                        lower: /[a-z]/.test(val),
                        digit: /[0-9]/.test(val),
                        special: /[^a-zA-Z0-9\s]/.test(val)
                    };
                    Object.keys(rules).forEach(function (key) {
                        var item = checklist.querySelector('[data-rule="' + key + '"]');
                        if (item) {
                            item.classList.toggle('is-valid', rules[key]);
                        }
                    });
                };
                pwdInput.addEventListener('input', updateChecklist);
                updateChecklist();
            }
        })();
    </script>
{% endblock %}
