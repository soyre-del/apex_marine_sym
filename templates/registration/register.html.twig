{% extends 'base.html.twig' %}

{% block title %}Create Account | Apex Marine{% endblock %}
{% block body_class %}auth-page{% endblock %}
{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
{% endblock %}

{% block body %}
    <main class="auth-shell container d-flex flex-column align-items-center justify-content-center py-5">

        <a class="auth-brand mb-4" href="{{ path('app_home') }}">
            <img src="{{ asset('images/Logo.png') }}" alt="Apex Marine">
            <span>Apex&nbsp;<strong>Marine</strong></span>
        </a>

        <section class="auth-card w-100" aria-labelledby="registration-heading">
            <div class="auth-content">

                <div class="auth-heading">
                    <h1 id="registration-heading">Create your account</h1>
                    <p>Register to get started with Apex Marine.</p>
                </div>

                {% if not registrationForm.vars.valid %}
                    <div class="auth-alert" role="alert">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="vertical-align:-.15em;margin-right:.4rem"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        {{ form_errors(registrationForm) }}
                    </div>
                {% endif %}

                {{ form_start(registrationForm, {attr: {class: 'registration-form auth-form', novalidate: 'novalidate'}}) }}

                    <div class="mb-3">
                        <label class="form-label" for="{{ registrationForm.fullName.vars.id }}">Full name</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                            {{ form_widget(registrationForm.fullName, {
                                attr: {class: 'form-control', placeholder: 'Your full name'}
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.fullName) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="{{ registrationForm.email.vars.id }}">Email address</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-9.1 6.1a2 2 0 0 1-2.2 0L2 7"/></svg>
                            {{ form_widget(registrationForm.email, {
                                attr: {class: 'form-control', placeholder: 'you@example.com'}
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="{{ registrationForm.plainPassword.vars.id }}">Password</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            {{ form_widget(registrationForm.plainPassword, {
                                attr: {class: 'form-control', placeholder: 'Create a strong password'}
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    <div class="form-check mb-4">
                        {{ form_widget(registrationForm.agreeTerms, {attr: {class: 'form-check-input'}}) }}
                        <label class="form-check-label" for="{{ registrationForm.agreeTerms.vars.id }}">
                            I agree to the terms &amp; conditions
                        </label>
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>

                    <button class="btn w-100 auth-submit" type="submit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="margin-right:.4rem"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                        Create account
                    </button>

                {{ form_end(registrationForm) }}

                <p class="auth-switch">
                    Already have an account?
                    <a href="{{ path('app_login') }}">Log in</a>
                </p>

            </div>
        </section>

        <a class="auth-home-link mt-4" href="{{ path('app_home') }}">
            ← Back to Apex Marine
        </a>

    </main>
{% endblock %}
